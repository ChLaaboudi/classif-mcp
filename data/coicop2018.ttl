<http://classif-mcp.local/unsd/coicop2018/09.2.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "09.2.2" ;
    skos:prefLabel "Sporting, camping and open-air recreation equipment (SD)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/09.2> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/09.2.2/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/09.2.2/note/additionalContentNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/09.2.2/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/09.2.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* gymnastic, physical education and sporting equipment, such as balls, shuttlecocks, nets, rackets, bats, skis, golf clubs, foils, sabres, poles, javelins and weights, dumb-bells, chest expanders and other body-building equipment_x000D_\n* parachutes, paragliders and other skydiving equipment_x000D_\n* firearms and/or ammunition, other weapons, and body armour for hunting, sport and personal protection_x000D_\n* fishing rods and other fishing equipment_x000D_\n* equipment for beach and open-air games, such as bowls, croquet, flying disc games and volleyball_x000D_\n* inflatable boats, rafts and swimming pools_x000D_\n* skateboards, kickboards, smart balance wheels and hover boards_x000D_\n* camping equipment, such as tents, sleeping bags, backpacks for camping, air mattresses, inflating pumps, camping stoves and gas, barbecues and other camping accessories_x000D_\n* walking sticks and canes for recreational purposes (e.g., hiking and tracking)"@en .

<http://classif-mcp.local/unsd/coicop2018/09.2.2/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* game-specific footwear (ski boots, football boots, golfing shoes and other such footwear fitted with ice skates, rollers, spikes, studs, etc.); protective sports headgear; and other protective sports gear, such as life jackets, boxing gloves, sport gloves, body padding, shin guards, goggles, belts and supports_x000D_\n* materials purchased by households with the intention of undertaking maintenance and repair themselves_x000D_\n* Global Positioning System (GPS) (satellite-based radionavigation positioning) equipment for boating and hiking"@en .

<http://classif-mcp.local/unsd/coicop2018/09.2.2/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* garden and camping furniture (05.1.1.2)_x000D_\n* motorcycle and bicycle crash helmets (07.2.1.3)_x000D_\n* rental and repair of sporting, camping and open-air recreation equipment (09.4.4.0)"@en .

