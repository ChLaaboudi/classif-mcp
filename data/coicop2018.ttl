<http://classif-mcp.local/unsd/coicop2018/01.1.2.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.2.1" ;
    skos:prefLabel "Live land animals (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1.2> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.2.1/note/coreContentNote> ;
