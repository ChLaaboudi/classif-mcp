<http://classif-mcp.local/unsd/coicop2018/01.1.4.4/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Milk of non-animal origin in all forms."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.4/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* almond milk_x000D_\n* coconut milk for drinking_x000D_\n* oat milk_x000D_\n* rice milk_x000D_\n* soy milk_x000D_\n* other milk from vegetables and nuts"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.4/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* coconut milk for cooking (01.1.9.3)"@en .

