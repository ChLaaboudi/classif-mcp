    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.3.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.3.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.1/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Fish, live, fresh, chilled or frozen."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* fish, live, purchased as food_x000D_\n* fish, fresh, chilled or frozen_x000D_\n* fish fillets and meat, whether minced or not, fresh, chilled or frozen"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* meal, livers, roes, fins, maws and other offal (01.1.3.7)"@en .

