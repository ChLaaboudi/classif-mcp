    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/06.4/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/06.4/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* diagnostic imaging services and medical laboratory services_x000D_\n* patient emergency transportation and rescue services"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "06.4.1" ;
    skos:prefLabel "Diagnostic imaging services and medical laboratory services (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/06.4> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/06.4.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/06.4.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/06.4.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* services provided by medical analysis laboratories (e.g., blood and urine testing)_x000D_\n* diagnostic imaging services for patient diagnosis and monitoring, including all diagnostic imaging methods (e.g., computed tomography (CT), magnetic resonance imaging (MRI), sonography and X-rays and radiation)"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* diagnostic imaging services and medical laboratory services not priced separately from outpatient preventive care services (06.2.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.1.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "06.4.1.0" ;
    skos:prefLabel "Diagnostic imaging services and medical laboratory services (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/06.4.1> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/06.4.1.0/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/06.4.1.0/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/06.4.1.0/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* services of medical analysis laboratories (e.g., urine/blood tests)_x000D_\n* diagnostic imaging services including all diagnostic imaging methods (i.e. CT, MRI, sonography); imagining diagnosis comprises a variety of services that employ imaging technology, such as X-rays and radiation for the diagnosis and monitoring of patients"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.1.0/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* diagnostic imaging services and medical laboratory services not priced separately from outpatient preventive care services (06.2.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "06.4.2" ;
