<http://classif-mcp.local/unsd/coicop2018/03.2.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* repair of footwear_x000D_\n* shoe-cleaning services_x000D_\n* dyeing of shoes_x000D_\n* hire of footwear"@en .

