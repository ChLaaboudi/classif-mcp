    skos:prefLabel "Imputed rental payments of owner-occupiers for their main residence (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/04.2> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/04.2.1/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/04.2.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* imputed rentals of owners occupying their main residence"@en .

<http://classif-mcp.local/unsd/coicop2018/04.2.1.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "04.2.1.0" ;
    skos:prefLabel "Imputed rental payments of owner-occupiers for their main residence (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/04.2.1> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/04.2.1.0/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/04.2.1.0/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* imputed rentals of owners occupying their main residence"@en .

<http://classif-mcp.local/unsd/coicop2018/04.2.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "04.2.2" ;
    skos:prefLabel "Other imputed rentals (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/04.2> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/04.2.2/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/04.2.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* imputed rentals for secondary residences_x000D_\n* imputed garage rentals in connection with the dwelling_x000D_\n* imputed rentals of storage units"@en .

<http://classif-mcp.local/unsd/coicop2018/04.2.2.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "04.2.2.0" ;
    skos:prefLabel "Other imputed rentals (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/04.2.2> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/04.2.2.0/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/04.2.2.0/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* imputed rentals for secondary residences_x000D_\n* imputed garage rentals in connection with the dwelling_x000D_\n* imputed rentals of storage units"@en .

<http://classif-mcp.local/unsd/coicop2018/04.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "04.3" ;
    skos:prefLabel "Maintenance, repair and security of the dwelling"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/04> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/04.3/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/04.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Maintenance and repair of dwellings are activities that are distinguished by two features: first, they have to be undertaken regularly if the dwelling is to remain in good working order; second, they do not change the dwelling’s performance, capacity or expected service life._x000D_\n_x000D_\nThere are two types of maintenance and repair of dwellings: those that are minor, such as interior decoration and repair to fittings and that are commonly carried out by both tenants and owner-occupiers, or major, such as replastering walls or repairing roofs, which are carried out only by owners._x000D_\n_x000D_\nOnly the expenditures incurred by tenants and owner-occupiers on materials and services related to interior decoration and to other such minor maintenance and repair, which would normally be seen as the responsibility of a tenant, are considered part of the individual consumption expenditure of households._x000D_\n_x000D_\nExpenditure incurred by owners, including owner-occupiers, on dwelling-related interior decoration and minor maintenance and repair that would normally be seen as the responsibility of a landlord, are considered intermediate expenditure and should not be treated as final consumption expenditure of households. Expenditure incurred by owners, including owner-occupiers, on major maintenance and repair are seen as gross fixed capital formation and thus also outside the scope of COICOP._x000D_\n_x000D_\nMaterials purchased by tenants or owner-occupiers with the intention of undertaking minor maintenance or repair themselves should be assigned to subclass 04.3.1.1. If tenants or owner-occupiers pay an enterprise to carry out the minor maintenance or repair, the total value of the services, including the costs of the materials used, should be assigned to subclass 04.3.2.0. However, the cost of the materials should be assigned to 04.3.1.1 if they are separately priced."@en .

<http://classif-mcp.local/unsd/coicop2018/04.3.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "04.3.1" ;
    skos:prefLabel "Security equipment and materials for dwelling maintenance and repair"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/04.3> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/04.3.1/note/inclusionNote> ;
