<http://classif-mcp.local/unsd/coicop2018/02> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "02" ;
    skos:prefLabel "Alcoholic beverages, tobacco and narcotics"@en ;
    skos:topConceptOf <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/02/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/02/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Division 02 covers the purchase of alcoholic beverages (02.1), tobacco products (02.3) and narcotics (02.4), regardless of where they are consumed, excluding the purchase of those products in facilities such as restaurants through their food and beverage serving services._x000D_\n _x000D_\nDivision 02 also includes low-alcohol beverages; and non-alcoholic beverages that are generally alcoholic, such as non-alcoholic beer. Services for the production of alcohol for own consumption (02.2) are also included within this division._x000D_\n_x000D_\nDivision 02 excludes alcoholic beverages purchased for immediate consumption for example in hotels, restaurants, cafés, bars and kiosks and from street vendors and automatic vending machines (11.1.1)."@en .

<http://classif-mcp.local/unsd/coicop2018/02.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "02.1" ;
    skos:prefLabel "Alcoholic beverages"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/02> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/02.1/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/02.1/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "The beverages classified here include low-alcohol beverages and non-alcoholic beverages that generally contain some alcohol."@en .

<http://classif-mcp.local/unsd/coicop2018/02.1.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "02.1.1" ;
    skos:prefLabel "Spirits and liquors (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/02.1> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/02.1.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/02.1.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/02.1.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* eaux de vie, liqueurs and other spirits with a high alcohol content_x000D_\n* mead_x000D_\n* pomace brandies, such as pisco, grappa and marc_x000D_\n* aperitifs, other than wine-based aperitifs"@en .

<http://classif-mcp.local/unsd/coicop2018/02.1.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* wine-based aperitifs (02.1.2.1, 02.1.2.2)."@en .

