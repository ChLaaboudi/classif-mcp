    xkos:plainText "* furnishing fabrics (05.2.1.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/03.1.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "03.1.2" ;
    skos:prefLabel "Garments (SD)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/03.1> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/03.1.2/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/03.1.2/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/03.1.2/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/03.1.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Garments for men and boys, women and girls and infants, either ready-to-wear or made to measure, in all materials (including leather, furs, plastics and rubber), for everyday wear, for sport or for work."@en .

<http://classif-mcp.local/unsd/coicop2018/03.1.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* capes, overcoats, raincoats, anoraks, parkas, blousons, jackets, trousers, waistcoats, suits, costumes, dresses, skirts, etc._x000D_\n* shirts, blouses, pullovers, sweaters, cardigans, shorts, swimsuits, tracksuits, jogging suits, sweatshirts, T-shirts, leotards, etc._x000D_\n* vests, underpants, socks, stockings, tights, petticoats, brassieres, knickers, slips, girdles, corsets, body stockings, etc._x000D_\n* pyjamas, nightshirts, nightdresses, housecoats, dressing gowns, bathrobes, etc._x000D_\n* traditional garments"@en .

<http://classif-mcp.local/unsd/coicop2018/03.1.2/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* tailoring services for which the customer supplies the material (03.1.4.2)_x000D_\n* articles of medical hosiery, such as elasticated stockings (06.1.2.2)_x000D_\n* diapers (nappies) of any material (13.2.9.1)"@en .

