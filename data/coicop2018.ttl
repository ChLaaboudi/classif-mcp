    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/02.3.0.1/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/02.3.0.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* cigarettes_x000D_\n* cigarettes that are purchased in bars and restaurants, provided that a service charge is not applied"@en .

<http://classif-mcp.local/unsd/coicop2018/02.3.0.2> a skos:Concept ;
