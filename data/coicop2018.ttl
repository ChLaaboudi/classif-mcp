    skos:prefLabel "Ready-made food and other food products (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1> .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.9.1" ;
    skos:prefLabel "Ready-made food (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1.9> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/additionalContentNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Prepared food and meals that either can be eaten as is or after heating but that do not require cooking, or are assembled and portioned in such a way that they can be cooked. They may contain mixed ingredients and can be fresh, frozen, or dehydrated or instant. They can include sauces and dressings which, especially when the food is fresh, may be provided in separate containers. Sometimes, disposable forks, knives, spoons or chopsticks are packed together with the food."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* precooked dishes containing stuffed pasta, rice or other cereals, such as couscous, including vegetables, meat, fish, cheese or other ingredients; and ready-to- eat dumplings, ravioli, noodles and similar dishes, including sauce_x000D_\n* ready-made dishes and meals based on precooked meat, meat substitutes or fish_x000D_\n* TV dinners_x000D_\n* mixed salads and other prepared dishes and meals based on vegetables, pulses or potatoes and also including other ingredients, such as meat, fish and cheese_x000D_\n* sandwiches, pizzas, quiches, meat or fish pies, whether frozen or not_x000D_\n* omelettes, crepes and other food products based on eggs when precooked and served as a main dish_x000D_\n* ready-made soups including dehydrated and instant soups and stews;_x000D_\n* other prepared ready-made dishes and meals, n.e.c."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* meal-kits"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* bread and bakery products, and cakes (01.1.1.3)_x000D_\n* macaroni, noodles, couscous and similar pasta products uncooked, whether stuffed or not (01.1.1.5)_x000D_\n* cheese (01.1.4.5) and yoghurt 01.1.4.6)_x000D_\n* chipped potatoes, frozen (01.1.7.9)_x000D_\n* ice cream (0.1.1.8.6) and other desserts, n.e.c. (01.1.8.9)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.9.2" ;
