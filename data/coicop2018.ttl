    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/06.4.2/note/additionalContentNote> .

<http://classif-mcp.local/unsd/coicop2018/06.4.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* ambulance services for individuals, with or without emergency rescue_x000D_\n* medical emergency transportation by airplane or other types of vehicles, whether or not they have been specially adapted for medical purposes"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.2/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* medical transport services memberships"@en .

<http://classif-mcp.local/unsd/coicop2018/06.4.2.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
