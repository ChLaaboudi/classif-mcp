<http://classif-mcp.local/unsd/coicop2018/01.1.1.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.1.1" ;
    skos:prefLabel "Cereals (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1.1> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/additionalContentNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Dried cereal grains, whether broken or precooked (steamed), not further prepared."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* wheat_x000D_\n* rice, including parboiled rice_x000D_\n* sorghum_x000D_\n* barley_x000D_\n* millet_x000D_\n* maize (corn)_x000D_\n* quinoa_x000D_\n* teff"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* bulgur_x000D_\n* rye_x000D_\n* oats_x000D_\n* triticale_x000D_\n* buckwheat_x000D_\n* canary seed_x000D_\n* quihuicha, or Inca wheat_x000D_\n* canagua, or coaihua_x000D_\n* adlay or Job’s tears_x000D_\n* mixed cereal grains, in the form of dried grains, also including other ingredients (provided that none of these is the main ingredient) but not further processed"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* flour of cereals (01.1.1.2)_x000D_\n* breakfast cereals (01.1.1.4)_x000D_\n* cereal-based ready-made preparations such as-ready-made soups based on cereals (01.1.9.1)_x000D_\n* baby rice cereals and other baby cereals (01.1.9.2)_x000D_\n* seeds for planting (09.3.1.2)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
