<http://classif-mcp.local/unsd/coicop2018/01.1.8.6/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* ice cubes for drinks_x000D_\n* ice cream and kulfi_x000D_\n* sorbet_x000D_\n* frozen yoghurt_x000D_\n* ice pop"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.8.6/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* tofu ice cream"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.8.6/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* ice for cooling (04.5.5.0)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.8.9> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.8.9" ;
