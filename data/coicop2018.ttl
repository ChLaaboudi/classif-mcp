<http://classif-mcp.local/unsd/coicop2018/scheme> a skos:ConceptScheme ;
    skos:prefLabel "COICOP 2018"@en ;
    skos:note "Classification converted from a published file by classif-mcp. Not an official linked-data publication; check against the source file."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/COICOP_2018_English_structure.xlsx> .

<http://classif-mcp.local/unsd/coicop2018/01> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01" ;
    skos:prefLabel "Food and non-alcoholic beverages"@en ;
    skos:topConceptOf <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/01/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Division 01 covers food (01.1) purchased by households mainly for consumption or preparation at home and non-alcoholic beverages (01.2) purchased by households, regardless of where they are consumed. Division 01 excludes food and non-alcoholic beverages that are provided by facilities such as restaurants and school cafeterias through their food and beverage serving services (division 11)._x000D_\n_x000D_\nServices purchased for the processing of primary goods provided by households to produce food and non-alcoholic beverages for their own consumption are also classified under this division (01.3)._x000D_\n_x000D_\nFood comprises all edible goods that are purchased and consumed by households for the purpose of nourishment. Food includes: cereals and cereal products; meat; fish and other seafood; milk, other dairy products and eggs; oils and fats; fruit and nuts; vegetables, tubers, plantains, cooking bananas and pulses; sugar, confectionery and desserts; salt, condiments and sauces; and spices, culinary herbs and seeds._x000D_\n_x000D_\nDivision 01 also includes baby food and ready-made food that can be eaten as is or after heating._x000D_\n_x000D_\nDivision 01 does not include alcoholic beverages (02.1)."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1" ;
    skos:prefLabel "Food"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01.1/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Group 01.1 covers food purchased by households mainly for consumption or preparation at home, excluding food that is provided by facilities such as restaurants through their food-serving services._x000D_\n_x000D_\nFood comprises all edible goods that are purchased and consumed by households for the purpose of nourishment. Food includes: cereals and cereal products; meat; fish and other seafood; milk, other dairy products and eggs; oils and fats; fruits and nuts; vegetables, tubers, plantains, cooking bananas and pulses; sugar, confectionery and desserts; and salt, condiments and sauces and spices, culinary herbs and seeds."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* products that need to be cooked or further prepared as well as ready-made food"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* services related to local delivery of food or drinks, when separately priced (07.4.9.2)_x000D_\n* products for animal feeding (09.3.2.2)_x000D_\n* food provided by food serving services (division 11)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.1" ;
    skos:prefLabel "Cereals and cereal products (ND)"@en ;
