<http://classif-mcp.local/unsd/coicop2018/01.1.4.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Other milk and cream from all animals."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.3/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* powdered, whole or skimmed milk_x000D_\n* evaporated and condensed milk_x000D_\n* fresh, clotted, thickened and whipped cream"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.3/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* baked milk"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.3/note/exclusionNote> a xkos:ExplanatoryNote ;
