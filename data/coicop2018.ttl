    skos:broader <http://classif-mcp.local/unsd/coicop2018/07.3.1> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/07.3.1.2/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/07.3.1.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* transport of persons and accompanied luggage by rapid transit (electric railways that operate on an exclusive right of way, which cannot be accessed by pedestrians or any other types of vehicles, and which is often grade-separated in tunnels or on elevated railways), light rail, underground, rubber-tyred metro and people mover_x000D_\n* transport of persons and accompanied luggage by tram"@en .

<http://classif-mcp.local/unsd/coicop2018/07.3.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "07.3.2" ;
    skos:prefLabel "Passenger transport by road (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/07.3> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/07.3.2/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/07.3.2/note/additionalContentNote> .

<http://classif-mcp.local/unsd/coicop2018/07.3.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* transport of persons and accompanied luggage by bus, trolleybus, and coach_x000D_\n* transport of persons and accompanied luggage by share taxi, a vehicle for hire that may be characterized as a cross between a taxicab and a bus. This mode of transport is often utilized in developing countries. Share taxis are typically smaller in size than buses, ranging from four-seat cars to minibuses, and are often owner-operated. They usually operate without a timetable along a fixed or semi-fixed route and may stop anywhere along that route to pick up or drop off passengers. _x000D_\n* transport of persons and accompanied luggage by taxi and hired vehicle, with driver_x000D_\n* transport of persons and accompanied luggage on the basis of private arrangements, such as carpooling and ride sharing_x000D_\n* local school bus charter services, with driver_x000D_\n* inter-urban and intercity school bus charter services operating by schedule_x000D_\n* transport of pupils by school bus between their homes and school and between schools, including in rural areas_x000D_\n* transport of persons and accompanied luggage by animal-drawn vehicles, with driver"@en .

<http://classif-mcp.local/unsd/coicop2018/07.3.2/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* tuk-tuks, auto and cycle rickshaws and motorcycles serving as taxis"@en .

