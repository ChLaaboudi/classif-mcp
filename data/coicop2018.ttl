<http://classif-mcp.local/unsd/coicop2018/01.1.4.7/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* milk-based desserts containing milk of animal and non-animal origin_x000D_\n* milk-based beverages containing milk of animal or non-animal origin, flavoured with cocoa, coffee or other substances"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.7/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* milk-based puddings containing milk of animal or non-animal origin, panna cotta, crème brûlée and crema catalana"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.7/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* lemon curd and similar fruit card (01.1.8.3)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.8> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
