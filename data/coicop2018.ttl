    skos:broader <http://classif-mcp.local/unsd/coicop2018/02.4> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/02.4.0/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/02.4.0/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/02.4.0/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* marijuana, opium, cocaine and their derivatives_x000D_\n* other vegetable-based narcotics, such as betel leaves, betel nuts, cola nuts, kava, khat (gat) and psilocybin mushrooms_x000D_\n* other narcotics, including chemicals and synthetic drugs"@en .

<http://classif-mcp.local/unsd/coicop2018/02.4.0/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* narcotics used for medicinal purpose (06.1.1.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/02.4.0.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
