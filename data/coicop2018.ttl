    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.9.3/note/additionalContentNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.9.3/note/exclusionNote> .

