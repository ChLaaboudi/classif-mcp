    xkos:plainText "* salt, sauces, condiments, and seasonings (including mustard, mayonnaise, ketchup, and soy sauce) and vinegar"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.3/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* coconut milk for cooking"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.3/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* coconut milk for drinking (01.1.4.4)_x000D_\n* fruit pickles (01.1.6.9)_x000D_\n*  vegetable pickles (01.1.7.9)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.4> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
