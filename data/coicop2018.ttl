    skos:prefLabel "Narcotics"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/02> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/02.4/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/02.4/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Group 02.4 covers all narcotics, both legal and illegal, purchased by households."@en .

<http://classif-mcp.local/unsd/coicop2018/02.4.0> a skos:Concept ;
