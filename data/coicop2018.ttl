    xkos:plainText "* pepper, pimento, ginger and other spices_x000D_\n* parsley, rosemary, thyme and other culinary herbs_x000D_\n* poppy seed, sesame seed, linseed and other seeds"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.4/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* vegetable oils (01.1.5.1)_x000D_\n* seeds for planting (09.3.1.2)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.9> a skos:Concept ;
