<http://classif-mcp.local/unsd/coicop2018/01.1.4.6/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* yoghurt_x000D_\n* buttermilk and other fermented dairy products_x000D_\n* curdled milk and cream_x000D_\n* kefir and other fermented or acidified milk and cream, whether or not they are concentrated, contain added sugar or other sweetening matter, are flavoured or contain added fruits, nuts or cocoa_x000D_\n* yoghurt from non-animal milk (e.g., coconut yoghurt and soy yoghurt)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.6/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* frozen yoghurt (01.1.8.6)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.7> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
