<http://classif-mcp.local/unsd/coicop2018/03.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "03.2" ;
    skos:prefLabel "Footwear"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/03> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/03.2/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/03.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Group 03.2 covers all general footwear, either ready-to-wear or made to measure, divided into the following categories: footwear for men; footwear for women; footwear for infants and children; and footwear-related services. Sport-specific footwear is classified to sub-class 09.2.2.1."@en .

<http://classif-mcp.local/unsd/coicop2018/03.2.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "03.2.1" ;
    skos:prefLabel "Shoes and other footwear (SD)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/03.2> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/03.2.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/03.2.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/03.2.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* all footwear for men, women, infants and children, either ready-to-wear or made to measure, including sports footwear suitable for everyday or leisure wear (shoes for jogging, cross-training, tennis, basketball, boating, etc.)_x000D_\n* gaiters and similar articles; shoelaces; and parts of footwear, such as heels, soles, etc., purchased by households with the intention of undertaking footwear repair themselves"@en .

<http://classif-mcp.local/unsd/coicop2018/03.2.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* polishes, creams and other shoe-cleaning articles (05.6.1.1)_x000D_\n* therapeutic footwear (06.1.3.3)_x000D_\n* game-specific footwear (ski boots, football boots, golfing shoes and other such footwear fitted with ice-skates, rollers, spikes, studs, etc.); shin guards, cricket pads and other such protective apparel for sport (09.2.2.1)"@en .

