<http://classif-mcp.local/unsd/coicop2018/12.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "12.2" ;
    skos:prefLabel "Financial services"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/12> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/12.2/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/12.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Financial services are subdivided by financial intermediation services indirectly measured and by the other forms of actual and implicit charges and remittance fees for financial services."@en .

<http://classif-mcp.local/unsd/coicop2018/12.2.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "12.2.1" ;
    skos:prefLabel "Financial intermediation services indirectly measured (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/12.2> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/12.2.1/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/12.2.1/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/12.2.1/note/additionalContentNote> .

<http://classif-mcp.local/unsd/coicop2018/12.2.1/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Financial intermediation services indirectly measured is calculated as the difference between the actual bank interest receivable and SNA interest receivable by financial corporations on the loans that they issue, and the difference between SNA interest payable and the actual bank interest payable by financial corporations on the deposits of their customers."@en .

<http://classif-mcp.local/unsd/coicop2018/12.2.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* financial intermediation services, indirectly measured, of deposit-taking corporations"@en .

<http://classif-mcp.local/unsd/coicop2018/12.2.1/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* implicit financial services provided by moneylenders, credit card issuers, finance associates of retailers who may be responsible for providing loans, pawnshops and corporations involved in lending (e.g., in providing student loans and import/export loans)"@en .

<http://classif-mcp.local/unsd/coicop2018/12.2.1.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
