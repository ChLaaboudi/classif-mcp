<http://classif-mcp.local/unsd/coicop2018/01.1.3.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Prepared foodstuffs consisting of fish, whether frozen or not."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.3/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* fillets covered only with batter or breadcrumbs, whether or not frozen_x000D_\n* canned fish_x000D_\n* surimi and other imitation crabmeat"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.3/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* prepared or preserved livers, roes, fins and other offal (01.1.3.7)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.4> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.3.4" ;
    skos:prefLabel "Other seafood, live, fresh, chilled or frozen (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1.3> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.3.4/note/inclusionNote> ;
