<http://classif-mcp.local/unsd/coicop2018/01.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.2" ;
    skos:prefLabel "Non-alcoholic beverages"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01> ;
