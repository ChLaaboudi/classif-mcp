<http://classif-mcp.local/unsd/coicop2018/01.1.4.8/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* eggs of hens and other birds in shell, fresh_x000D_\n* eggs of other animals, including turtle eggs, in shell, fresh_x000D_\n* eggs whether in shell or not, preserved or cooked_x000D_\n* egg yolks, fresh or preserved_x000D_\n* egg albumen"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.8/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* fish roe (01.1.3.7)_x000D_\n* omelettes, crêpes and other ready-made egg-based food products (01.1.9.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.9> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.4.9" ;
    skos:prefLabel "Other dairy products (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1.4> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.4.9/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.4.9/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.9/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* whey and casein_x000D_\n* cream, concentrated or containing added sugar or other sweeteners; and cream powder_x000D_\n* other products consisting of milk constituents, milk protein concentrates, and products obtained from whey"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.4.9/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* butter and other oils and fats derived from milk (01.1.5.2)_x000D_\n* ice cream (01.1.8.6)"@en .

