    skos:prefLabel "Life and accident insurance (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/12.1> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/12.1.1/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/12.1.1/note/additionalContentNote> .

<http://classif-mcp.local/unsd/coicop2018/12.1.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* service charges for life insurance, annuities, death benefit insurance, education insurance and so on"@en .

<http://classif-mcp.local/unsd/coicop2018/12.1.1/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* service charges for funeral insurance_x000D_\n* service charges for accident insurance"@en .

