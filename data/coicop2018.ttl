    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/07.2.4.4/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/07.2.4.4/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* hire of personal transport equipment without driver (e.g., car rental)_x000D_\n* fees for participation in car-, bicycle- and motorcycle-sharing schemes"@en .

<http://classif-mcp.local/unsd/coicop2018/07.2.4.4/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* passenger transport services by taxi and hired vehicle with driver (07.3.2.2)_x000D_\n* rental of personal transport equipment for recreation (09.4.2.2)_x000D_\n* service charges for personal transport equipment insurance (12.1.4.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/07.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "07.3" ;
    skos:prefLabel "Passenger transport services"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/07> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/07.3/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/07.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Purchases of transport services are generally classified by mode of transport. When a ticket covers two or more modes of transport – for example, intra-urban bus and underground; or inter-urban train and ferry – and the expenditure cannot be apportioned between them, then such purchases should be assigned to subclass 07.3.5.0._x000D_\n_x000D_\nCosts of meals, snacks, drinks, refreshments and accommodation services need to be included in group 07.3 if they are covered by the fare and not priced separately. If priced separately, those costs need to be classified under division 11._x000D_\n_x000D_\nSchool transport services are included in group 07.3; ambulance services, on the other hand, are excluded and assigned to subclass 06.4.2.0."@en .

<http://classif-mcp.local/unsd/coicop2018/07.3.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "07.3.1" ;
    skos:prefLabel "Passenger transport by railway (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/07.3> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/07.3.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/07.3.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/07.3.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* transport of persons and accompanied luggage by train, high-speed train, maglev, light railway (light rail), tram and underground_x000D_\n* transport of accompanied private vehicles"@en .

<http://classif-mcp.local/unsd/coicop2018/07.3.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* funicular transport (07.3.6.0)"@en .

