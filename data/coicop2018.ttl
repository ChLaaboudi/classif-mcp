<http://classif-mcp.local/unsd/coicop2018/02.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "02.3" ;
    skos:prefLabel "Tobacco"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/02> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/02.3/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/02.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Group 02.3 covers all purchases of tobacco and tobacco products by households, including purchases of tobacco in restaurants, cafés, bars and service stations, since those venues do not add value or a service to the tobacco products sold. The consumption of tobacco through use of shisha or hookah pipes in restaurants, cafés and bars, is covered by division 11, as the venues in this case do provide a service. Electronic cigarettes are included in group 02.3, even though they do not contain tobacco, as they are a substitute for tobacco products."@en .

<http://classif-mcp.local/unsd/coicop2018/02.3.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "02.3.0" ;
    skos:prefLabel "Tobacco (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/02.3> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/02.3.0/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/02.3.0/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/02.3.0/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* cigarettes, cigarette tobacco and tobacco leaf_x000D_\n* cigarette papers and single-use filters which are consumed together with the cigarette_x000D_\n* cigars, pipe tobacco, chewing tobacco and snuff_x000D_\n* refills for electronic cigarettes, with or without nicotine_x000D_\n* tobacco that is consumed with a shisha or a hookah pipe if consumed at home_x000D_\n* tobacco that is purchased in bars and restaurants, provided that a service charge is not applied"@en .

<http://classif-mcp.local/unsd/coicop2018/02.3.0/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* tobacco that is consumed through use of a shisha or hookah pipe in restaurants, bars, cafés and shisha lounges (11.1.1)_x000D_\n* electronic cigarette devices and other articles for smokers (13.2.9.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/02.3.0.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "02.3.0.1" ;
