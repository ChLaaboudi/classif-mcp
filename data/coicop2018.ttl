<http://classif-mcp.local/unsd/coicop2018/01.1.1.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Flour of cereals mentioned in subclass 01.1.1.1 whether instant (precooked – steamed – or added with yeasts) or not."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* flour of cereals listed under subclass 01.1.1.1"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.1.2/note/additionalContentNote> a xkos:ExplanatoryNote ;
