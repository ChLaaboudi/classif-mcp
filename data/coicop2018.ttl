<http://classif-mcp.local/unsd/coicop2018/01.1.9.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Food and beverages intended for baby use exclusively."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* baby formula (powdered, condensed and evaporated milk for baby use)_x000D_\n* baby rice cereals and flours for baby food_x000D_\n* homogenized baby food"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.2/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* cereals and flours not intended exclusively for baby use (01.1.1.1, 01.1.1.2)_x000D_\n* powdered milk not intended exclusively for baby use (01.1.4.3)_x000D_\n* yoghurt for children (01.1.4.6)_x000D_\n* homogenized preparations of fruits and vegetables not intended exclusively for baby use (01.1.6.9; 01.1.7.9)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.9.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.9.3" ;
