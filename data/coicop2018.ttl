<http://classif-mcp.local/unsd/coicop2018/13.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "13.3" ;
    skos:prefLabel "Social protection"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/13> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/13.3/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/13.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Social protection, as defined here, covers non-medical assistance and support services provided to persons who are elderly, disabled, have occupational injuries and diseases, are survivors, unemployed, destitute, homeless, low-income earners, indigenous people, immigrants, refugees, alcohol and substance abusers and so on_x000D_\n_x000D_\nIt also covers assistance and support services provided to families and children."@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "13.3.0" ;
    skos:prefLabel "Social protection (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/13.3> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/13.3.0/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/13.3.0/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Social protection services include residential care, home help and day care."@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* non-medical retirement homes for elderly persons, non-medical residences for disabled persons, rehabilitation centres providing non-medical long-term support for individuals rather than health care and rehabilitative therapy, schools for disabled persons where the main aim is to help students to overcome their disability_x000D_\n* non-medical help to maintain elderly and disabled persons at home (home-cleaning services, meal programmes, non-medical day-care centres, day-care services and holiday-care services)_x000D_\n* child-minding outside the home, including after-school centers, nurseries, day-care facilities, wet nurses, crèches, kindergartens (other than educational), play schools and other child-minding facilities_x000D_\n* counselling, guidance, arbitration, fostering and adoption services for families"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* babysitters and so on (05.6.2.1)_x000D_\n* social assistance and other social care services that are integrated into a package of care along with medical services are to be included in 06.2.3 if medical services do not require an overnight stay and in 06.3.2 if they do. For example, services of medical convalescent homes or convalescent hospitals; services of homes for the elderly with nursing care; inpatient care hospices; services of palliative care establishments for the terminally ill; services of nursing homes; rest homes with nursing care; services of skilled nursing facilities; services of teaching nursing homes; services of residential mental retardation facilities; mental health and substance abuse facilities for chronic patients (e.g., those with dementia); services of alcoholism or drug addiction rehabilitation facilities (other than licensed hospitals)_x000D_\n* services of mental health convalescent homes or hospitals (06.3.2.0)_x000D_\n* educational kindergartens (10.1.0.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "13.3.0.1" ;
    skos:prefLabel "Childcare services (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/13.3.0> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0.1/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* child-minding outside the home, including after-school centers, nurseries, day-care facilities, wet nurses, crèches, kindergartens (other than educational), play schools and other child-minding facilities"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* babysitters and so on (05.6.2.1)_x000D_\n* educational kindergartens (10.1.0.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "13.3.0.2" ;
    skos:prefLabel "Retirement homes for elderly persons and residences for disabled persons, not providing medical care (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/13.3.0> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0.2/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0.2/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* non-medical retirement homes for elderly persons_x000D_\n* non-medical residences for disabled or maladjusted persons"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.2/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* social assistance and other social care services that are integrated into a package of care along with medical services are to be included in 06.2.3 if medical services do not require an overnight stay and in 06.3.2 if they do. For example, services of medical convalescent homes or convalescent hospitals; services of homes for the elderly with nursing care; inpatient care hospices; services of palliative care establishments for the terminally ill; services of nursing homes; rest homes with nursing care; services of skilled nursing facilities; services of teaching nursing homes; services of residential mental retardation facilities; mental health and substance abuse facilities for chronic patients (e.g., those with dementia); services of alcoholism or drug addiction rehabilitation facilities (other than licensed hospitals)_x000D_\n* services of mental health convalescent homes or hospitals (06.3.2.0)"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "13.3.0.3" ;
    skos:prefLabel "Home care services for elderly and disabled (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/13.3.0> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0.3/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.3/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* help to maintain elderly and disabled persons at home (home-cleaning services, meal programmes, day-care centres, day-care services and holiday-care services)"@en .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.9> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
