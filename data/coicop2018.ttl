<http://classif-mcp.local/unsd/coicop2018/01.1.2.5/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Preparations of meat, offal and blood, whether frozen or not."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.2.5/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* sausages and similar meat, offal and blood products_x000D_\n* marinated meat_x000D_\n* canned meat, meat extracts and meat juices_x000D_\n* minced meat mix, from different types of meat_x000D_\n* all kind of pâté, including liver pâté_x000D_\n* breaded meat_x000D_\n* other preparations of meat, offal and blood"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.3" ;
    skos:prefLabel "Fish and other seafood (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.3/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.3/note/inclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.3/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1.3/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Fish and other seafood (such as crustaceans, molluscs and other aquatic invertebrates), harvested or farmed, in fresh and marine waters, whole or in parts (e.g., cuts, fillets and meat, whether minced or not), including livers, roes, fins, maws, meal and other offal."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* aquatic turtles_x000D_\n* other edible aquatic invertebrates and animals, such as sea cucumbers, sea urchins, sea squirts and jellyfish"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* marine mammals, frogs and terrestrial snails (01.1.2.1, 01.1.2.2, 01.1.2.3)_x000D_\n* seaweeds and other aquatic plants (01.1.7.4)"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.3.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "01.1.3.1" ;
    skos:prefLabel "Fish, live, fresh, chilled or frozen (ND)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/01.1.3> ;
