    xkos:plainText "* child-minding with an educational component (10.1.0.1)_x000D_\n* child-minding outside the home (13.3.0.1)"@en .

<http://classif-mcp.local/unsd/coicop2018/05.6.2.9> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "05.6.2.9" ;
    skos:prefLabel "Other household services (S)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/05.6.2> ;
