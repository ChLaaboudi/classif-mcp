    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/13.3.0.9/note/inclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/13.3.0.9/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* schools for disabled persons where the main aim is to help students to overcome their disability_x000D_\n* guidance, arbitration, fostering and adoption services for families"@en .

