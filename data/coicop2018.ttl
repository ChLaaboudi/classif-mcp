<http://classif-mcp.local/unsd/coicop2018/07.2> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "07.2" ;
    skos:prefLabel "Operation of personal transport equipment"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/07> ;
    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/07.2/note/coreContentNote> .

<http://classif-mcp.local/unsd/coicop2018/07.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Purchase of parts, accessories and lubricants made by households with the intention of undertaking maintenance, repair or fitting themselves should be assigned to class 07.2.1 or class 07.2.2. If a household pays an enterprise to carry out maintenance, repair or fitting, the total value of the service, including the cost of the materials used, should be assigned to class 07.2.3 if the materials are not separately priced."@en .

<http://classif-mcp.local/unsd/coicop2018/07.2.1> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/unsd/coicop2018/scheme> ;
    skos:notation "07.2.1" ;
    skos:prefLabel "Parts and accessories for personal transport equipment (SD)"@en ;
    skos:broader <http://classif-mcp.local/unsd/coicop2018/07.2> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/07.2.1/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/07.2.1/note/additionalContentNote> ;
    xkos:exclusionNote <http://classif-mcp.local/unsd/coicop2018/07.2.1/note/exclusionNote> .

<http://classif-mcp.local/unsd/coicop2018/07.2.1/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* tyres (new, used or retreaded), inner tubes, spark plugs, batteries, shock absorbers, filters, pumps and other replacement parts or accessories for personal transport equipment_x000D_\n* hubcaps, if purchased separately_x000D_\n* 	snow chains, roof racks, cargo roof boxes_x000D_\n* car, motorcycle and bicycle seats for babies and children_x000D_\n* crash helmets for use by bicyclists and motorcyclists_x000D_\n* fire extinguishers for transport equipment_x000D_\n* products used specifically for the cleaning and maintenance of transport equipment, such as paints, chrome cleaners, sealing compounds and bodywork polishes; covers for motor cars, motorcycles and so on_x000D_\n* dash cameras_x000D_\n* chargers for electric vehicles"@en .

<http://classif-mcp.local/unsd/coicop2018/07.2.1/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* crash helmets equipped with cameras"@en .

<http://classif-mcp.local/unsd/coicop2018/07.2.1/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* non-specific products used for cleaning and maintenance, such as household sponges, chamois leathers and detergents (05.6.1.1)_x000D_\n* services purchased for the fitting of parts and accessories and for the painting, washing and polishing of bodywork (07.2.3.0)_x000D_\n* audio and video systems for cars (08.1.4.0)"@en .

