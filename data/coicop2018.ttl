    xkos:coreContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.2.2/note/coreContentNote> ;
    xkos:inclusionNote <http://classif-mcp.local/unsd/coicop2018/01.1.2.2/note/inclusionNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/unsd/coicop2018/01.1.2.2/note/additionalContentNote> .

<http://classif-mcp.local/unsd/coicop2018/01.1.2.2/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Meat of all animals, both domestic and wild, fresh, chilled or frozen."@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.2.2/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* meat of cattle (cows; calves; common ox, zebu or humped ox; watusi; gaur; gayal, banteng and yak)_x000D_\n* meat of buffaloes (Indian or water buffaloes; arnis, or wild water buffaloes: Asiatic buffalo or arni, Sulawesi anoas, or pygmy buffaloes, African buffaloes, such as the dwarf buffalo and the large Caffrarian buffalo the American bisons, known simply as buffaloes; European bisons; and beefaloes (hybrid offspring of American bisons and domestic cattle)_x000D_\n* meat of pigs_x000D_\n* meat of goats, lambs and sheep_x000D_\n* meat of poultry (chickens, ducks, geese, turkeys and guinea fowl)_x000D_\n* meat of hares and rabbits_x000D_\n* meat of horses, donkeys and other equines_x000D_\n* meat of camels, dromedaries, alpaca, llamas, guanacos, vicuñas and other camelids_x000D_\n* meat of antelopes, deer, boars and kangaroos_x000D_\n* meat of ostriches, emus, rheas, pheasants, grouse, pigeons, quails and other birds_x000D_\n* meat of snakes, alligators and other reptiles_x000D_\n* spiders, scorpions, insects, and worms (not-live)_x000D_\n* terrestrial snails_x000D_\n* frogs"@en .

<http://classif-mcp.local/unsd/coicop2018/01.1.2.2/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "* minced meat of the animals listed directly above_x000D_\n* meat of seals, walruses, whales and other marine mammals"@en .

