@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xkos: <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


<http://classif-mcp.local/unsd/csa2/101> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/101/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/101/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers activities on population and demographic statistics; topics like demography, vital statistics, population structures and growth, demographic projections, families and households (marriages, divorces, household size)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/101> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/101/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/101/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Causes of death (105)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/102> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/102/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/102/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on the movement of people, refugees, asylum seekers, internally displaced people, workers, the duration of migration stay or absence, immigration, emigration, migrant flows and stocks, including related migration governance indicators, etc.\nIncludes also:\n• Internally displaced people"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/102> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/102/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/102/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Human trafficking (408).\n• Stateless persons (504)"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/103> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/103/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/103/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on work including both employment and work not for pay or profit, labour force, labour market, and unemployment. The more detailed topics include, among others, economically active population, labour conditions, new working arrangements (new forms of work), health and safety at work (accidents at work, occupational injuries and diseases, work-related health problems), working time and other working conditions, strikes and lockouts, job vacancies, job creation, wages and salaries, and labour costs."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/103> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/103/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/103/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Unemployment insurance and unemployment benefits (107)\n• Trade union membership (402)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/104> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/104/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/104/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on educational participation, illiteracy, educational institutions and systems, human and financial resources invested in education, lifelong learning, vocational training and adult learning, impact of education, assessments of student performance, etc."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/105> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/105/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/105/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers health and mortality related statistical activities, including topics like life expectancy, health status, health and safety, health determinants (including lifestyle, nutrition, smoking, alcohol and drug use), health resources and expenditure, health care systems, morbidity and mortality (including infant and child mortality), hospital admission, causes of illness and death, specific diseases (e.g. AIDS), disabilities, pharmaceutical consumption and sales, health personnel, remuneration of health professions, environmental health status, health inequality."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/105> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/105/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/105/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Work related health and safety (103)\n• Victimization from criminal behaviour (408)\n• Traffic accidents and injuries (20304)\n• Health accounts (20101)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/106> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/106/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/106/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on household income and expenditures from the household or individual viewpoint (all types of income and expenditure), including topics like distribution of incomes, in-kind income, income transfers received and paid, income or expenditure-based measures of poverty, consumer protection, consumption patterns, consumer goods and durables, household wealth and debts."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/106> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/106/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/106/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Social protection schemes against various risks (107)\n• Tax schemes (20103)\n• Poverty in a multidimensional sense (505)\n• Living conditions (505)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/107> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/107/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/107/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on measures to protect people against the risks of inadequate incomes associated with unemployment, ill health, invalidity, old age, parental responsibilities, or following the loss of a spouse or parent, etc., includes statistics on pension beneficiaries, social security schemes, social protection expenditure, etc."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/107> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/107/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/107/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Insurance companies as economic actors (20306)\n• Pension funds as actors in financial markets (20306)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/108> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/108/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/108/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on housing, dwellings and human settlements."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/109> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/109/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/109/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities dealing with cultural activities in society, such as theatre, cinemas, museums, libraries, mass media, music, book production, sports and recreation, expenditure and financing of culture."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/110> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/110/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/110/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on the use of time by individuals, often related to work-life balance (reconciling family responsibilities and paid work) and unpaid work, leisure time, personal activities, and social connections."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/199> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/199/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/199/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "A residual category for any activities on demographic and social statistics that cannot be classified under the areas above."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/201> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/201/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/201/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on macroeconomic accounts and macroeconomic statistics. It includes institutional sectors and industries. This category includes the aggregation, consolidation and reconciliation of the different components of economic statistics."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20101> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20101/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20101/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on National Accounts. This category includes the compilation of the integrated economic accounts, as well as extended and thematic accounts (satellite accounts) and tables, regional accounts, (extended) supply and use tables, input-output tables and from whom-to-whom tables. This includes macroeconomic statistics on the informal economy as well as on the illegal economy."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20101> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/20101/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/20101/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Balance of payments and international investment position (20102)\n• Government finance statistics (20103)\n• Monetary and financial statistics (20104)\n• System of Environmental Economic Accounting (20105)\n• Composite indicators covering multiple areas of the economy (20199)\n• Safety and security (408)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20102> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20102/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20102/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on balance of payments and international investment positions, including Foreign Direct Investment (FDI)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20102> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/20102/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/20102/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• International trade on goods and services statistics (204)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20103> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20103/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20103/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on the general government sector and the broader public sector.  It covers the compilation of data on revenues, expenditures, transactions in financial assets and liabilities, and balance sheet data."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20104> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20104/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20104/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on the compilation of stock and flow of data on the financial and nonfinancial assets and liabilities of an economy's financial corporations sector, and the compilation of stock and flow data on the financial assets and liabilities of all other sectors of an economy."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20104> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/20104/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/20104/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Government finance statistics (20103)\n• Banking, insurance, financial market statistics (20306)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20105> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20105/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20105/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on the System of Environmental-Economic Accounting (SEEA). Includes ecosystem accounts and thematic accounts such as water accounts, energy accounts, forest accounts, ocean accounts, biodiversity accounts, etc. Excludes activities on traditional environment statistics which are not compiled in the format of accounts."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20105> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/20105/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/20105/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Agriculture, forestry and fishing statistics (20301)\n• Energy statistics (20302)\n• Environment statistics (3)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20199> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20199/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20199/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on macroeconomic accounts and statistics that are nowhere else classified. It includes business cycle analysis, composite indicators, etc."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/202> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/202/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/202/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on economy-wide activities of businesses across different sectors (as opposed to 20301-20307 that deal with specific individual sectors). Covers topics like statistics on economic activities of businesses, business demography, business investment, business services, demand for services, industrial performance, enterprises by size class, industrial production, commodities, structure of sales and services, outputs of the service industries, non-profit institutions, labour statistics collected from businesses."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/202> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/202/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/202/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Sectoral statistics (203)\n• Social and solidarity economy (510)\n• Statistical business registers (60301)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20201> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20201/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20201/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers activities on business statistics with higher than annual frequency (e.g., quarterly, monthly, etc.) across multiple industries. It includes business tendency surveys, and employment and wages surveys if they are conducted among businesses."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20201> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/20201/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/20201/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Wages reported as a source of household income (106)\n• Short-term statistics on a specific sector (203)\n• Short-term indicators on international trade (204)\n• Producer Price Indices (PPI) (205)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20202> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20202/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20202/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers statistical activities on the structure, economic activity, and performance of businesses across multiple industries on an annual basis."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

<http://classif-mcp.local/unsd/csa2/20202> xkos:exclusionNote <http://classif-mcp.local/unsd/csa2/20202/note/exclusionNote> .
<http://classif-mcp.local/unsd/csa2/20202/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Excludes:\n• Business demography and business dynamics (20203)\n• Entrepreneurship (20204)\n• Sectoral statistics (203)\n• Trade in goods statistics by enterprise characteristics (TEC) and Services trade by enterprise characteristics (STEC) (204)."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/CSA2/CSA2_Exp_Notes.xlsx> ;
    skos:editorialNote "Explanatory notes of CSA 2.0 as published by UNSD. Converted by classif-mcp; check against the source file."@en .

