<http://classif-mcp.local/unsd/csa2/20399> xkos:coreContentNote <http://classif-mcp.local/unsd/csa2/20399/note/coreContentNote> .
<http://classif-mcp.local/unsd/csa2/20399/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "Covers activities in other areas of sectoral statistics that are not elsewhere classified. Includes, for example, real estate statistics."@en ;
