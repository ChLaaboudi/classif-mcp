    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/103200/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/103200/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/103200/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- manufacture of fruit or vegetable juices"@en .

<http://classif-mcp.local/i14y/noga2025/103200/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la fabrication de jus de fruits ou de légumes"@fr .

<http://classif-mcp.local/i14y/noga2025/103200/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Frucht- und Gemüsesäften"@de .

<http://classif-mcp.local/i14y/noga2025/103200/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- produzione di succhi a base di frutta o ortaggi"@it .

<http://classif-mcp.local/i14y/noga2025/103200/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- production of concentrates from fresh fruits and vegetables"@en .

<http://classif-mcp.local/i14y/noga2025/103200/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- la production de concentrés à partir de fruits et de légumes frais"@fr .

<http://classif-mcp.local/i14y/noga2025/103200/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von Konzentraten aus frischem Obst und Gemüse"@de .

<http://classif-mcp.local/i14y/noga2025/103200/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- produzione di nettari di frutta concentrati da frutta e ortaggi freschi"@it .

<http://classif-mcp.local/i14y/noga2025/103200/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- manufacture of beverages produced with fruit nectars, see 110700"@en .

<http://classif-mcp.local/i14y/noga2025/103200/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la fabrication de boissons à base de nectars de fruits, voir 110700"@fr .

<http://classif-mcp.local/i14y/noga2025/103200/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Getränken aus Fruchtnektaren, siehe 110700"@de .

<http://classif-mcp.local/i14y/noga2025/103200/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- produzione di bevande prodotte con nettari di frutta, cfr. 110700"@it .

