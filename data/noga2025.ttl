    skos:prefLabel "Obst- und Gemüseverarbeitung"@de ;
    skos:prefLabel "Lavorazione e conservazione di frutta e ortaggi"@it .

<http://classif-mcp.local/i14y/noga2025/1031> a skos:Concept ;
