<http://classif-mcp.local/i14y/noga2025/331400> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "331400" ;
    skos:prefLabel "Repair and maintenance of electrical equipment"@en ;
