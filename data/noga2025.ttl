    skos:prefLabel "Erbringung sonstiger Reservierungsdienstleistungen"@de ;
    skos:prefLabel "Altri servizi di prenotazione e attività connesse"@it .

<http://classif-mcp.local/i14y/noga2025/799000> a skos:Concept ;
