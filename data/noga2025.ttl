    skos:prefLabel "Discothèques, boîtes de nuits, night clubs"@fr ;
    skos:prefLabel "Diskotheken, Nachtclubs, Nightclubs"@de ;
    skos:prefLabel "Discoteche, locali notturni, night club"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- discotheques, dance halls, night clubs (with beverage serving predominant)"@en .

<http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- les discothèques, les salles de danse, les boîtes de nuit (où l'on sert principalement des boissons)"@fr .

<http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Diskotheken, Tanzlokale, Nachtclubs (in denen überwiegend Getränke angeboten werden)"@de .

<http://classif-mcp.local/i14y/noga2025/563002/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n\n- discoteche, sale da ballo, night club (in cui prevale la somministrazione di bevande)"@it .

<http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- operation of concert halls and music venues, see 903100\n\n- operation of dance floors where beverage serving is not the main activity, see 932900"@en .

<http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- l'exploitation de salles de concert et de lieux musicaux, voir 903100\n\n- l'exploitation de pistes de danse où le service de boissons n'est pas l'activité principale, voir 932900"@fr .

<http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Betrieb von Konzerthallen und Musikclubs, siehe 903100\n- Betrieb von Tanzlokalen, bei denen der Ausschank von Getränken nicht die Haupttätigkeit ist, siehe 932900"@de .

<http://classif-mcp.local/i14y/noga2025/563002/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- gestione di sale da concerto e locali musicali, cfr. 903100 \n- gestione di piste da ballo in cui la somministrazione di bevande non rappresenta l'attività principale, cfr. 932900"@it .

<http://classif-mcp.local/i14y/noga2025/564> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "564" ;
    skos:prefLabel "Intermediation service activities for food and beverage services activities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/56> ;
    skos:prefLabel "Activités de service d’intermédiation pour des activités de service de restauration"@fr ;
    skos:prefLabel "Vermittlungstätigkeiten für gastronomische Dienstleistungen"@de ;
    skos:prefLabel "Attività di servizi di intermediazione per servizi di ristorazione"@it .

<http://classif-mcp.local/i14y/noga2025/5640> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "5640" ;
    skos:prefLabel "Intermediation service activities for food and beverage services activities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/564> ;
    skos:prefLabel "Activités de service d’intermédiation pour des activités de service de restauration"@fr ;
    skos:prefLabel "Vermittlungstätigkeiten für gastronomische Dienstleistungen"@de ;
    skos:prefLabel "Attività di servizi di intermediazione per servizi di ristorazione"@it .

<http://classif-mcp.local/i14y/noga2025/564000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "564000" ;
    skos:prefLabel "Intermediation service activities for food and beverage services activities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/5640> ;
    skos:prefLabel "Activités de service d’intermédiation pour des activités de service de restauration"@fr ;
    skos:prefLabel "Vermittlungstätigkeiten für gastronomische Dienstleistungen"@de ;
    skos:prefLabel "Attività di servizi di intermediazione per servizi di ristorazione"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes the intermediation of food and beverage services by bringing clients and service providers together for a fee or commission without the intermediary providing the food and beverage services intermediated. These intermediation activities can be carried out on digital platforms or through non-digital channels (including face-to-face, door-to-door, telephone, post, and so on). The fee or commission can be received from either the client or the provider of the food and beverage service. Revenue for the intermediation activities can include other sources of income (for example, revenues from the sale of advertising space)."@en .

<http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend l'intermédiation de services de restauration en mettant en relation des clients et des prestataires de services moyennant une rémunération ou une commission, sans que l'intermédiaire ne fournisse les services de restauration intermédiés. Ces activités d'intermédiation peuvent être menées sur des plateformes numériques ou par des canaux non numériques (y compris le face-à-face, le porte-à-porte, le téléphone, le courrier, etc.). Les honoraires ou commissions peuvent être perçus soit par le client, soit par le fournisseur de services de restauration. Les revenus des activités d'intermédiation peuvent inclure d'autres sources de revenus (par ex. revenus provenant de la vente d'espaces publicitaires)."@fr .

<http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst die Vermittlung von gastronomischen Dienstleistungen, indem Kunden und Dienstleistungsanbieter gegen Gebühr oder auf Provisionsbasis zusammengebracht werden, wobei der Vermittler die vermittelten gastronomischen Dienstleistungen nicht selbst erbringt. Diese Vermittlungstätigkeiten können auf digitalen Plattformen oder über nicht digitale Kanäle (einschliesslich persönlich, von Tür zu Tür, telefonisch, per Post usw.) erfolgen. Der Vermittler erhält die Gebühr oder Provision entweder vom Kunden oder vom Anbieter der gastronomischen Dienstleistungen. Einnahmen aus der Vermittlungstätigkeit können auch andere Einkommensquellen umfassen (z. B. Einnahmen aus dem Verkauf von Werbeflächen)."@de .

<http://classif-mcp.local/i14y/noga2025/564000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include i servizi di intermediazione per servizi di ristorazione, che consistono nel mettere in contatto clienti e fornitori di servizi a fronte di un compenso o di una commissione, senza che l'intermediario fornisca i servizi di ristorazione oggetto di intermediazione. \nQuesti servizi di intermediazione possono essere svolti su piattaforme digitali o attraverso canali non digitali (faccia a faccia, porta a porta, canali telefonici, postali, eccetera). \nIl compenso o la commissione possono essere percepiti sia dai clienti sia dai fornitori dei servizi di ristorazione. I ricavi dei servizi di intermediazione possono includere altre fonti di reddito, ad esempio i ricavi derivanti dalla vendita di spazi pubblicitari."@it .

<http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- reservation services for restaurants"@en .

<http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- les services de réservation pour les restaurants"@fr .

<http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Reservierungsdienstleistungen für Restaurants"@de .

<http://classif-mcp.local/i14y/noga2025/564000/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- servizi di prenotazione per ristoranti"@it .

<http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- operation of online platforms to allow people to book a food delivery, see 533000"@en .

<http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- l'exploitation de plates-formes en ligne permettant de réserver une livraison de nourriture, voir 533000"@fr .

<http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Betrieb von Online-Plattformen, die es Kunden ermöglichen, eine Lebensmittellieferung zu bestellen, siehe 533000"@de .

<http://classif-mcp.local/i14y/noga2025/564000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- gestione di piattaforme online che consentono alle persone di prenotare la consegna di generi alimentari, cfr. 533000"@it .

<http://classif-mcp.local/i14y/noga2025/58> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "58" ;
