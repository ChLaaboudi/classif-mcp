    skos:prefLabel "Travaux de couverture"@fr ;
    skos:prefLabel "Dachdeckerei und Zimmerei"@de ;
    skos:prefLabel "Realizzazione di coperture"@it .

<http://classif-mcp.local/i14y/noga2025/434101> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "434101" ;
    skos:prefLabel "Roof framing works"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4341> ;
