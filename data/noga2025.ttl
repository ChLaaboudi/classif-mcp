<http://classif-mcp.local/i14y/noga2025/132003> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "132003" ;
    skos:prefLabel "Other textile weaving"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/1320> ;
    skos:prefLabel "Tissage d'autres matières textiles"@fr ;
    skos:prefLabel "Sonstige Weberei"@de ;
    skos:prefLabel "Tessitura di altre materie tessili"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/132003/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/132003/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/132003/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/132003/note/inclusionNote/it> ;
