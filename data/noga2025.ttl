<http://classif-mcp.local/i14y/noga2025/014600/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- l'élevage et la reproduction de porcs et d'animaux de l'espèce porcine"@fr .

<http://classif-mcp.local/i14y/noga2025/014600/note/inclusionNote/de> a xkos:ExplanatoryNote ;
