    skos:broader <http://classif-mcp.local/i14y/noga2025/2453> ;
    skos:prefLabel "Fonderie de métaux légers"@fr ;
    skos:prefLabel "Leichtmetallgiessereien"@de ;
    skos:prefLabel "Fusione di getti in metalli leggeri"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/245300/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/245300/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/245300/note/inclusionNote/de> ;
