<http://classif-mcp.local/i14y/noga2025/475500> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "475500" ;
    skos:prefLabel "Retail sale of furniture, lighting equipment, tableware and other household goods"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4755> ;
    skos:prefLabel "Commerce de détail de meubles, d’appareils d’éclairage, de vaisselle et d’autres biens domestiques"@fr ;
    skos:prefLabel "Einzelhandel mit Möbeln, Einrichtungsgegenständen und sonstigem Hausrat"@de ;
    skos:prefLabel "Commercio al dettaglio di mobili, di articoli per l’illuminazione, articoli per la tavola e altri articoli per la casa"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/475500/note/inclusionNote> ;
