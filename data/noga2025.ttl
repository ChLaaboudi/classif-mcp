    skos:prefLabel "Personenbeförderung in der Luftfahrt"@de ;
    skos:prefLabel "Trasporto aereo di passeggeri"@it .

<http://classif-mcp.local/i14y/noga2025/511000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "511000" ;
    skos:prefLabel "Passenger air transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/5110> ;
    skos:prefLabel "Transports aériens de passagers"@fr ;
    skos:prefLabel "Personenbeförderung in der Luftfahrt"@de ;
    skos:prefLabel "Trasporto aereo di passeggeri"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- scheduled air transport of passengers over regular routes\n- charter flights for passengers\n- sightseeing flights"@en .

<http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- le transport aérien régulier de passagers sur des lignes régulières\n- les vols par charters pour passagers\n- les vols touristiques"@fr .

<http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Personenbeförderung im Linienflugverkehr\n- Charterflüge für Personen\n- Rundflüge"@de .

<http://classif-mcp.local/i14y/noga2025/511000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- trasporto aereo di linea di passeggeri su rotte regolari\n- voli charter per trasporto di passeggeri\n- voli panoramici e turistici"@it .

<http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- rental of air transport equipment with an operator for the purpose of passenger transport"@en .

<http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- la location de matériel de transport aérien avec un opérateur à des fins de transport de passagers"@fr .

<http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Vermietung von Luftfahrzeugen mit Bedienungspersonal zur Personenbeförderung"@de .

<http://classif-mcp.local/i14y/noga2025/511000/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- noleggio di mezzi per il trasporto aereo di passeggeri con operatore"@it .

<http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- rental of air transport equipment without an operator, see 773500\n- air ambulances, see 869200"@en .

<http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la location de matériel de transport aérien sans un opérateur, voir 773500\n- les ambulances aériennes, voir 869200"@fr .

<http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Vermietung von Luftfahrzeugen ohne Bedienungspersonal, siehe 773500\n- Flugrettung, siehe 869200"@de .

<http://classif-mcp.local/i14y/noga2025/511000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- noleggio di mezzi per il trasporto aereo senza operatore, cfr. 773500\n- servizi di ambulanza aerea, cfr. 869200"@it .

<http://classif-mcp.local/i14y/noga2025/512> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "512" ;
