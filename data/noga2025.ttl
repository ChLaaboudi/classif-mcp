    skos:prefLabel "Reproduction d’enregistrements"@fr ;
    skos:prefLabel "Vervielfältigung von bespielten Ton-, Bild- und Datenträgern"@de ;
    skos:prefLabel "Riproduzione di supporti registrati"@it .

<http://classif-mcp.local/i14y/noga2025/1820> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "1820" ;
    skos:prefLabel "Reproduction of recorded media"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/182> ;
    skos:prefLabel "Reproduction d’enregistrements"@fr ;
    skos:prefLabel "Vervielfältigung von bespielten Ton-, Bild- und Datenträgern"@de ;
