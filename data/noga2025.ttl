    skos:prefLabel "Produzione di metalli preziosi di base e di altri metalli non ferrosi"@it .

<http://classif-mcp.local/i14y/noga2025/2441> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2441" ;
