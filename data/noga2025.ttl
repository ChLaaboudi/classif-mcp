    skos:prefLabel "Vermittlungstätigkeiten für den Einzelhandel ohne ausgeprägten Schwerpunkt"@de ;
    skos:prefLabel "Attività di servizi di intermediazione per il commercio al dettaglio non specializzato"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/479100/note/inclusionNote> ;
