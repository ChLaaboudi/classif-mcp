<http://classif-mcp.local/i14y/noga2025/468600> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "468600" ;
    skos:prefLabel "Wholesale of other intermediate products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4686> ;
    skos:prefLabel "Commerce de gros d’autres produits intermédiaires"@fr ;
    skos:prefLabel "Grosshandel mit sonstigen Halbwaren"@de ;
    skos:prefLabel "Commercio all’ingrosso di altri prodotti intermedi"@it ;
