    skos:prefLabel "Herstellung von Wäsche"@de ;
    skos:prefLabel "Fabbricazione di biancheria intima"@it .

<http://classif-mcp.local/i14y/noga2025/142201> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "142201" ;
    skos:prefLabel "Manufacture of gents’ and boys’ underwear"@en ;
