    skos:broader <http://classif-mcp.local/i14y/noga2025/47> ;
    skos:prefLabel "Commerce de détail de produits alimentaires, de boissons et de tabac"@fr ;
    skos:prefLabel "Einzelhandel mit Nahrungs- und Genussmitteln, Getränken und Tabakwaren"@de ;
    skos:prefLabel "Commercio al dettaglio di prodotti alimentari, bevande e tabacchi"@it ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group excludes food and beverage processing and manufacturing activities, see divisions 10 and 11."@en .

<http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce groupe ne comprend pas les activités de transformation et de fabrication de produits alimentaires et de boissons, voir divisions 10 et 11."@fr .

<http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Gruppe umfasst nicht die Verarbeitung und Herstellung von Lebensmitteln und Getränken, siehe Abteilungen 10 und 11."@de .

<http://classif-mcp.local/i14y/noga2025/472/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo gruppo non include le attività di lavorazione e produzione di alimenti e bevande, cfr. divisioni 10, 11"@it .

<http://classif-mcp.local/i14y/noga2025/4721> a skos:Concept ;
