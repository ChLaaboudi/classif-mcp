<http://classif-mcp.local/i14y/noga2025/463500> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "463500" ;
    skos:prefLabel "Wholesale of tobacco products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4635> ;
    skos:prefLabel "Commerce de gros de produits à base de tabac"@fr ;
    skos:prefLabel "Grosshandel mit Tabakwaren"@de ;
    skos:prefLabel "Commercio all'ingrosso di prodotti del tabacco"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- wholesale of tobacco and smoking products and accessories, including lighters, pipes, cigarette rolling equipment, etc."@en .

<http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- le commerce de gros de tabac et de produits et accessoires pour fumeurs, y compris les briquets, les pipes, le matériel pour rouler les cigarettes, etc."@fr .

<http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Grosshandel mit Tabakwaren und Raucherbedarfsartikeln, einschliesslich Feuerzeugen, Pfeifen, Zubehör zum Drehen von Zigaretten usw."@de .

<http://classif-mcp.local/i14y/noga2025/463500/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- commercio all'ingrosso di tabacco e accessori per fumatori, inclusi accendini, pipe, macchinette per arrotolare le sigarette, eccetera"@it .

<http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- wholesale of electronic cigarettes (vapes)"@en .

<http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- le commerce de gros de cigarettes électroniques (vapes)"@fr .

<http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Grosshandel mit elektronischen Zigaretten (Vaporizer)"@de .

<http://classif-mcp.local/i14y/noga2025/463500/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- commercio all'ingrosso di sigarette elettroniche (vapes)"@it .

<http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- wholesale of e-liquids for electronic cigarettes, see 468500"@en .

<http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- le commerce de gros d'e-liquides pour cigarettes électroniques, voir 468500"@fr .

<http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Grosshandel mit E-Liquids für elektronische Zigaretten, siehe 468500"@de .

<http://classif-mcp.local/i14y/noga2025/463500/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- commercio all'ingrosso di liquidi per inalazione per sigarette elettroniche, cfr. 468500"@it .

<http://classif-mcp.local/i14y/noga2025/4636> a skos:Concept ;
