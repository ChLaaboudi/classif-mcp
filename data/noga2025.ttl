    skos:prefLabel "Gestion d’installations sportives"@fr ;
    skos:prefLabel "Betrieb von Sportanlagen"@de ;
    skos:prefLabel "Gestione di impianti sportivi"@it .

<http://classif-mcp.local/i14y/noga2025/931100> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "931100" ;
    skos:prefLabel "Operation of sports facilities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/9311> ;
    skos:prefLabel "Gestion d’installations sportives"@fr ;
    skos:prefLabel "Betrieb von Sportanlagen"@de ;
    skos:prefLabel "Gestione di impianti sportivi"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/931100/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/931100/note/inclusionNote/fr> ;
