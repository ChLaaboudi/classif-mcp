    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/462100/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/462100/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/462100/note/exclusionNote> ;
