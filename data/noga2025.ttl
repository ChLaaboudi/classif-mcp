    skos:prefLabel "Posa in opera di infissi"@it .

<http://classif-mcp.local/i14y/noga2025/433201> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "433201" ;
    skos:prefLabel "Installation of kitchens"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4332> ;
