    skos:notation "477409" ;
    skos:prefLabel "Retail sale of medical and orthopaedic goods n.e.c."@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4774> ;
    skos:prefLabel "Commerce de détail d'articles médicaux et orthopédiques n.c.a."@fr ;
    skos:prefLabel "Einzelhandel mit medizinischen und orthopädischen Artikeln a. n. g."@de ;
    skos:prefLabel "Commercio al dettaglio di articoli medici e ortopedici n.c.a."@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477409/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477409/note/inclusionNote/fr> ;
