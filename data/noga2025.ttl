    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- operation of botanical and zoological gardens, including children’s zoos\n- operation of aquariums"@en .

<http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la gestion des jardins botaniques et zoologiques, y compris les zoos pour enfants\n- l'exploitation d'aquariums"@fr .

<http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Betrieb von botanischen und zoologischen Gärten, einschliesslich Streichelzoos\n- Betrieb von Aquarien"@de .

<http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- gestione di giardini botanici e zoologici, inclusi zoo per bambini\n- gestione di acquari"@it .

<http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- landscape and gardening activities, see 813000\n\n- operation of sport fishing and hunting preserves, see 931900"@en .

<http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- les activités d'aménagement paysager et de jardinage, voir 813000\n- l'exploitation de réserves pour la pêche et la chasse sportive, voir 931900"@fr .

<http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Garten- und Landschaftsbau, siehe 813000\n- Betrieb von Sportfischerei- und -jagdrevieren, siehe 931900"@de .

<http://classif-mcp.local/i14y/noga2025/914100/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- attività paesaggistiche e di giardinaggio, cfr. 813000\n- gestione di riserve di pesca e di caccia sportive, cfr. 931900"@it .

