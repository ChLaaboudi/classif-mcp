<http://classif-mcp.local/i14y/noga2025/324000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "324000" ;
    skos:prefLabel "Manufacture of games and toys"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/3240> ;
    skos:prefLabel "Fabrication de jeux et jouets"@fr ;
    skos:prefLabel "Herstellung von Spielwaren"@de ;
    skos:prefLabel "Fabbricazione di giochi e giocattoli"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/324000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/324000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/324000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/324000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/324000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/324000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/324000/note/additionalContentNote/de> ;
