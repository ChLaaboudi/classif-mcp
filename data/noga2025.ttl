    skos:notation "472500" ;
    skos:prefLabel "Retail sale of beverages"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4725> ;
    skos:prefLabel "Commerce de détail de boissons"@fr ;
    skos:prefLabel "Einzelhandel mit Getränken"@de ;
    skos:prefLabel "Commercio al dettaglio di bevande"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/472500/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/472500/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/472500/note/inclusionNote/de> ;
