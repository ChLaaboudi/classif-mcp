    skos:prefLabel "Allevamento di ovini e caprini"@it .

<http://classif-mcp.local/i14y/noga2025/014500> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "014500" ;
    skos:prefLabel "Raising of sheep and goats"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/0145> ;
    skos:prefLabel "Élevage d’ovins et de caprins"@fr ;
    skos:prefLabel "Haltung von Schafen und Ziegen"@de ;
    skos:prefLabel "Allevamento di ovini e caprini"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/014500/note/inclusionNote> ;
