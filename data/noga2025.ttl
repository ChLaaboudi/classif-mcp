    skos:prefLabel "Attività di intermediari del commercio all’ingrosso non specializzato"@it .

<http://classif-mcp.local/i14y/noga2025/461900> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "461900" ;
    skos:prefLabel "Activities of agents involved in non-specialised wholesale"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4619> ;
    skos:prefLabel "Activités d’intermédiaire non spécialisé du commerce de gros"@fr ;
    skos:prefLabel "Tätigkeiten der Grosshandelsvermittlung von Waren ohne ausgeprägten Schwerpunkt"@de ;
    skos:prefLabel "Attività di intermediari del commercio all’ingrosso non specializzato"@it ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/461900/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/461900/note/exclusionNote/fr> ;
