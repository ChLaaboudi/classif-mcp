    skos:prefLabel "Gasverteilung durch Rohrleitungen"@de ;
    skos:prefLabel "Distribuzione di combustibili gassosi mediante condotte"@it .

<http://classif-mcp.local/i14y/noga2025/352200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "352200" ;
    skos:prefLabel "Distribution of gaseous fuels through mains"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/3522> ;
    skos:prefLabel "Distribution de combustibles gazeux par conduites"@fr ;
    skos:prefLabel "Gasverteilung durch Rohrleitungen"@de ;
    skos:prefLabel "Distribuzione di combustibili gassosi mediante condotte"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/352200/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/352200/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/352200/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/352200/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/352200/note/exclusionNote> ;
