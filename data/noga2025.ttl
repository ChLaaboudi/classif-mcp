    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/962100/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/962100/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/962100/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- hair washing, trimming and cutting, setting, dyeing, tinting, waving, straightening and similar activities\n\n- hairstyling\n\n- shaving and beard trimming"@en .

<http://classif-mcp.local/i14y/noga2025/962100/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- le lavage, la taille et la coupe des cheveux, la mise en plis, la teinture, la coloration, l'ondulation, le défrisage et les activités similaires\n\n- la coiffure\n\n- le rasage et la taille de la barbe"@fr .

<http://classif-mcp.local/i14y/noga2025/962100/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Haarwäsche, Schneiden, Legen, Färben, Tönen, Wellen, Glätten und ähnliche Dienstleistungen\n- Hairstyling\n- Rasur und Bartpflege"@de .

<http://classif-mcp.local/i14y/noga2025/962100/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- attività di lavaggio, taglio, messa in piega, tintura, colorazione, ondulazione, stiratura e attività simili\n- hairstyling (servizi di acconciatura)\n- attività di rasatura e rifinitura della barba"@it .

<http://classif-mcp.local/i14y/noga2025/962100/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- manufacture of wigs, see 329900"@en .

<http://classif-mcp.local/i14y/noga2025/962100/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la fabrication de perruques, voir 329900"@fr .

<http://classif-mcp.local/i14y/noga2025/962100/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Perücken, siehe 329900"@de .

<http://classif-mcp.local/i14y/noga2025/962100/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di parrucche, cfr. 329900"@it .

<http://classif-mcp.local/i14y/noga2025/9622> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
