    skos:broader <http://classif-mcp.local/i14y/noga2025/141> ;
    skos:prefLabel "Fabrication d’articles à mailles"@fr ;
    skos:prefLabel "Herstellung von Bekleidung aus gewirktem und gestricktem Stoff"@de ;
    skos:prefLabel "Fabbricazione di articoli a maglia e all’uncinetto"@it .

<http://classif-mcp.local/i14y/noga2025/141001> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "141001" ;
    skos:prefLabel "Manufacture of knitted and crocheted hosiery"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/1410> ;
    skos:prefLabel "Fabrication de bas et collants en bonneterie"@fr ;
    skos:prefLabel "Herstellung von gestrickten und gehäkelten Strumpfwaren"@de ;
    skos:prefLabel "Fabbricazione di articoli di calzetteria in maglia e all'uncinetto"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- manufacture of hosiery, including socks, tights and pantyhose"@en .

<http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication d'articles de bonneterie, y compris les chaussettes, les collants et les bas"@fr .

<http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Strumpfwaren, einschliesslich Socken, Strümpfen und Strumpfhosen"@de .

<http://classif-mcp.local/i14y/noga2025/141001/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di articoli di calzetteria, inclusi calzini, collant e calzamaglie"@it .

<http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- manufacture of medical stockings and hosiery"@en .

<http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- la fabrication de bas et de collants médicaux"@fr .

<http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von medizinischen Strümpfen und Strumpfwaren"@de .

<http://classif-mcp.local/i14y/noga2025/141001/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- fabbricazione di calze e calzetteria medica"@it .

<http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- manufacture of knitted or crocheted brassieres and corsets, see 142202"@en .

<http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la fabrication de soutiens-gorge et de corsets en bonneterie, voir 142202"@fr .

<http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von gestrickten oder gewirkten Büstenhaltern und Korsetten, siehe 142202"@de .

<http://classif-mcp.local/i14y/noga2025/141001/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di reggiseni e corsetti realizzati a maglia e all'uncinetto, cfr. 142202"@it .

<http://classif-mcp.local/i14y/noga2025/141002> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "141002" ;
    skos:prefLabel "Manufacture of other knitted and crocheted apparel"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/1410> ;
    skos:prefLabel "Fabrication d'autres articles en bonneterie"@fr ;
    skos:prefLabel "Herstellung von sonstiger Bekleidung aus Gewirken und Gestricken"@de ;
    skos:prefLabel "Fabbricazione di altri capi di abbigliamento a maglia e all'uncinetto"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of knitted or crocheted wearing apparel (e.g. pullovers, cardigans, jerseys, shirts, T-shirts, blouses, waistcoats, nightwear, underwear, including babies’ wear)\n- manufacture of knitted and crocheted sportswear and swimwear"@en .

<http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication de vêtements et d'autres articles confectionnés en bonneterie (par ex. pulls, cardigans, maillots, chemises, T-shirts, chemisiers, gilets, vêtements de nuit, sous-vêtements, y compris les vêtements pour bébés)\n- la fabrication de vêtements de sport et de maillots de bain en bonneterie"@fr .

<http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von gestrickter oder gewirkter Bekleidung (z. B. Pullover, Strickjacken, Hemden, T-Shirts, Blusen, Westen, Nachtwäsche, Unterwäsche, einschliesslich Bekleidung für Kleinkinder)\n- Herstellung von gestrickter oder gewirkter Sport- und Badebekleidung"@de .

<http://classif-mcp.local/i14y/noga2025/141002/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di articoli di abbigliamento realizzati a maglia e all'uncinetto, ad esempio pullover, cardigan, maglie, camicie, T-shirt, camicette, gilet, indumenti da notte e biancheria intima, inclusi indumenti per neonati\n- fabbricazione di abbigliamento sportivo e costumi da bagno realizzati a maglia e all'uncinetto"@it .

<http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- manufacture of footwear without applied soles, knitted or crocheted"@en .

<http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- la fabrication de chaussures en bonneterie"@fr .

<http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von gestrickter oder gewirkter Fussbekleidung ohne angebrachte Sohlen"@de .

<http://classif-mcp.local/i14y/noga2025/141002/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- fabbricazione di calzature senza suole applicate, realizzate a maglia o all'uncinetto"@it .

<http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- manufacture of knitted and crocheted fabrics, see 139100"@en .

<http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la fabrication d'étoffes à mailles, voir 139100"@fr .

<http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Gestricken und Gewirken, siehe 139100"@de .

<http://classif-mcp.local/i14y/noga2025/141002/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di tessuti a maglia e all'uncinetto, cfr. 139100"@it .

<http://classif-mcp.local/i14y/noga2025/142> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "142" ;
    skos:prefLabel "Manufacture of other wearing apparel and accessories"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/14> ;
    skos:prefLabel "Fabrication d’autres articles d’habillement et accessoires"@fr ;
    skos:prefLabel "Herstellung von sonstiger Bekleidung und Bekleidungszubehör"@de ;
    skos:prefLabel "Fabbricazione di altri articoli di abbigliamento e accessori"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group includes the manufacture of wearing apparel, other than knitted or crocheted. The material used may be of any kind and may be coated, impregnated or rubberised."@en .

<http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce groupe comprend la fabrication de vêtements autres qu'en bonneterie. La matière utilisée peut être de toute nature et peut être enduite, imprégnée ou caoutchoutée."@fr .

<http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Gruppe umfasst die Herstellung von Bekleidung, die nicht aus Gestricken oder Gewirken besteht. Dazu können Stoffe aller Art verwendet werden, und diese können überdies bestrichen, getränkt oder gummiert sein."@de .

<http://classif-mcp.local/i14y/noga2025/142/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo gruppo include la fabbricazione di articoli di abbigliamento diversi da quelli a maglia. Il materiale utilizzato può essere di qualsiasi tipo e può essere rivestito, impregnato o gommato."@it .

<http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group excludes:\n\n- repair of wearing apparel, see 952900"@en .

<http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce groupe ne comprend pas :\n\n- la réparation de vêtements, voir 952900"@fr .

<http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Abteilung umfasst nicht:\n- Reparatur von Bekleidung, siehe 952900"@de .

<http://classif-mcp.local/i14y/noga2025/142/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo gruppo non include:\n- riparazione di articoli di abbigliamento, cfr. 952900"@it .

<http://classif-mcp.local/i14y/noga2025/1421> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "1421" ;
    skos:prefLabel "Manufacture of outerwear"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/142> ;
    skos:prefLabel "Fabrication de vêtements de dessus"@fr ;
    skos:prefLabel "Herstellung von Oberbekleidung"@de ;
    skos:prefLabel "Fabbricazione di abbigliamento esterno"@it ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class excludes:\n\n- uniforms and similar official clothing, see 142300\n\n- manufacture of wearing apparel of rubber or plastics, see 221200, 222600"@en .

<http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Cette classe ne comprend pas :\n\n- les uniformes et vêtements officiels similaires, voir 142300\n\n- la fabrication de vêtements en caoutchouc ou en plastique, voir 221200, 222600"@fr .

<http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Klasse umfasst nicht:\n- Herstellung von Uniformen und ähnlicher Dienstbekleidung, siehe 142300\n- Herstellung von Bekleidung aus Kautschuk oder Kunststoff, siehe 221200, 222600"@de .

<http://classif-mcp.local/i14y/noga2025/1421/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questa classe non include:\n- fabbricazione di uniformi e indumenti ufficiali simili, cfr. 142300\n- fabbricazione di articoli di abbigliamento in gomma o materie plastiche, cfr. 221200, 222600"@it .

<http://classif-mcp.local/i14y/noga2025/142101> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "142101" ;
    skos:prefLabel "Manufacture of men’s and boys’ outerwear"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/1421> ;
    skos:prefLabel "Fabrication de vêtements de dessus pour hommes et garçons"@fr ;
    skos:prefLabel "Herstellung von Oberbekleidung für Männer und Jungen"@de ;
    skos:prefLabel "Confezione di abbigliamento esterno per uomo e ragazzo"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of men's and boys’ outerwear, other than knitted or crocheted (e.g. pullovers, cardigans, jersey, coats, suits, ensembles, jackets, trousers, skirts, shirts, T-shirts, blouses)"@en .

<http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication de vêtements de dessus pour hommes et garçons, autres qu'en bonneterie, par ex. pulls, cardigans, maillots, manteaux, costumes, ensembles, vestes, pantalons, jupes, chemises, T-shirts, chemisiers"@fr .

<http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Oberbekleidung für Männer und Knaben, ausgenommen solche aus Gestricken oder Gewirken (z. B. Pullover, Strickjacken, Mäntel, Anzüge, Kostüme, Jacken, Hosen, Röcke, Hemden, T-Shirts, Blusen)"@de .

<http://classif-mcp.local/i14y/noga2025/142101/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di indumenti esterni diversi da quelli a maglia per uomini e ragazzi, ad esempio pullover, cardigan, maglie, cappotti, abiti, completi, giacche, pantaloni, gonne, camicie, magliette, camicette"@it .

<http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- manufacture of knitted and crochetted apparel, e.g. pullovers, cardigans, jerseys, shirts, T-shirts, blouses, waistcoats, nightwear, underwear, including babies’ wear, see 141002"@en .

<http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la fabrication de vêtements et d'autres articles confectionnés en bonneterie (par ex. pulls, cardigans, maillots, chemises, T-shirts, chemisiers, gilets, vêtements de nuit, sous-vêtements, y compris les vêtements pour bébés), voir 141002"@fr .

<http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von gestrickter oder gewirkter Bekleidung (z. B. Pullover, Strickjacken, Hemden, T-Shirts, Blusen, Westen, Nachtwäsche, Unterwäsche, einschliesslich Bekleidung für Kleinkinder), siehe 141002"@de .

<http://classif-mcp.local/i14y/noga2025/142101/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di articoli di abbigliamento realizzati a maglia e all’uncinetto (ad esempio pullover, cardigan, maglie, camicie, T-shirt, camicette, gilet, indumenti da notte, biancheria intima, inclusi indumenti per neonati), cfr. 141002"@it .

<http://classif-mcp.local/i14y/noga2025/142102> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
