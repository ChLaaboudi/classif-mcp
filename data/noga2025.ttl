    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471103/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/471103/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- non specialised retail sale with food predominance, on shops with a sales surface ranging between 100 and 399 m2"@en .

<http://classif-mcp.local/i14y/noga2025/471103/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- le commerce de détail non spécialisé à prédominance alimentaire, dans des magasins dont la surface de vente est comprise entre 100 et 399 m2"@fr .

<http://classif-mcp.local/i14y/noga2025/471103/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- nicht spezialisierter Einzelhandel mit überwiegender Lebensmittelauswahl, in Läden mit einer Verkaufsfläche zwischen 100 und 399 m2"@de .

<http://classif-mcp.local/i14y/noga2025/471103/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- commercio al dettaglio non specializzato a prevalenza alimentare, nei negozi con una superficie di vendita compresa tra 100 e 399 m2"@it .

<http://classif-mcp.local/i14y/noga2025/471104> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "471104" ;
    skos:prefLabel "Small stores (< 100 m2)"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4711> ;
    skos:prefLabel "Petits commerces (< 100 m2)"@fr ;
    skos:prefLabel "Kleine Geschäfte (< 100 m2)"@de ;
    skos:prefLabel "Piccoli esercizi (< 100 m2)"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- non specialised retail sale with food predominance, on shops with a sales surface of less than 100m2"@en .

<http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- le commerce de détail non spécialisé à prédominance alimentaire, dans les magasins dont la surface de vente est inférieure à 100m2"@fr .

<http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- nicht spezialisierter Einzelhandel mit überwiegender Lebensmittelauswahl, in Läden mit einer Verkaufsfläche von weniger als 100 m2"@de .

<http://classif-mcp.local/i14y/noga2025/471104/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- commercio al dettaglio non specializzato a prevalenza alimentare, nei negozi con una superficie di vendita inferiore a 100 m2"@it .

<http://classif-mcp.local/i14y/noga2025/4712> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "4712" ;
    skos:prefLabel "Other non-specialised retail sale"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/471> ;
    skos:prefLabel "Autre commerce de détail non spécialisé"@fr ;
    skos:prefLabel "Sonstiger Einzelhandel mit Waren verschiedener Art"@de ;
    skos:prefLabel "Commercio al dettaglio non specializzato di altri prodotti"@it .

<http://classif-mcp.local/i14y/noga2025/471200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "471200" ;
    skos:prefLabel "Other non-specialised retail sale"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4712> ;
    skos:prefLabel "Autre commerce de détail non spécialisé"@fr ;
    skos:prefLabel "Sonstiger Einzelhandel mit Waren verschiedener Art"@de ;
    skos:prefLabel "Commercio al dettaglio non specializzato di altri prodotti"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- retail sale of a large variety of goods (e.g. wearing apparel, furniture, appliances, hardware, cosmetics, jewellery, toys, sports goods) of which food products, beverages or tobacco are not predominant"@en .

<http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- le commerce de détail d'une grande variété de biens (par ex. articles d’habillement, meubles, appareils, quincaillerie, cosmétiques, bijoux, jouets, articles de sport) sans prédominance des produits alimentaires, des boissons et du tabac"@fr .

<http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Einzelhandel mit einem breit gefächerten Warensortiment (z. B. Bekleidung, Möbel, Haushaltsgeräte, Eisenwaren, Kosmetika, Schmuck, Spielzeug, Sportartikel), wobei Nahrungsmittel, Getränke oder Tabakwaren nicht die Hauptrichtung bilden"@de .

<http://classif-mcp.local/i14y/noga2025/471200/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include il commercio al dettaglio di un'ampia varietà di articoli (ad esempio articoli di abbigliamento, mobili, elettrodomestici, ferramenta, cosmetici) senza prevalenza di prodotti alimentari, bevande o tabacchi."@it .

<http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- non-specialised retail sale of second-hand goods, see 477902"@en .

<http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- le commerce de détail non spécialisé de biens d'occasion, voir 477902"@fr .

<http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Einzelhandel mit Gebrauchtwaren verschiedener Art, siehe 477902"@de .

<http://classif-mcp.local/i14y/noga2025/471200/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- commercio al dettaglio non specializzato di articoli di seconda mano, cfr. 477902"@it .

<http://classif-mcp.local/i14y/noga2025/472> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "472" ;
