    skos:prefLabel "Grosshandel mit Kraftwagenteilen und -zubehör"@de ;
    skos:prefLabel "Commercio all’ingrosso di parti e accessori di autoveicoli"@it .

<http://classif-mcp.local/i14y/noga2025/467200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "467200" ;
