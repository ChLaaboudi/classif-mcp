    skos:broader <http://classif-mcp.local/i14y/noga2025/4776> ;
    skos:prefLabel "Commerce de détail de produits pour le jardinage et l'agriculture"@fr ;
    skos:prefLabel "Einzelhandel mit Garten- und Landwirtschaftsprodukten"@de ;
    skos:prefLabel "Commercio al dettaglio di prodotti per il giardinaggio e l'agricoltura"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- retail sale of tools and supplies for gardening and farming, e.g. seeds, straw, phytosanitary products, fertilisers, etc."@en .

<http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- le commerce de détail d'outils et de fournitures pour le jardinage et l'agriculture, par ex. les semences, la paille, les produits phytosanitaires, les engrais, etc."@fr .

<http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Einzelhandel mit Werkzeugen und Zubehör für Garten und Landwirtschaft, z. B. Saatgut, Stroh, Pflanzenschutzmittel, Düngemittel usw."@de .

<http://classif-mcp.local/i14y/noga2025/477601/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- commercio al dettaglio di fertilizzanti e prodotti fitosanitari, nonché di attrezzi e forniture per il giardinaggio e l'agricoltura, ad esempio sementi e paglia"@it .

<http://classif-mcp.local/i14y/noga2025/477602> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "477602" ;
    skos:prefLabel "Retail sale of flowers and plants"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4776> ;
    skos:prefLabel "Commerce de détail de fleurs et de plantes"@fr ;
    skos:prefLabel "Einzelhandel mit Blumen und Pflanzen"@de ;
    skos:prefLabel "Commercio al dettaglio di fiori e piante"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- retail sale of pot or cut flowers\n\n- retail sale of plants\n\n- retail sale of ornamental or fruit trees and shrubs and pluriannual plants\n\n- retail sale of seedlings of flowers and vegetables"@en .

<http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- le commerce de détail de fleurs en pot ou coupées\n\n- le commerce de détail de plantes\n\n- le commerce de détail d'arbres et d'arbustes ornementaux ou fruitiers et de plantes pluriannuelles\n\n- le commerce de détail de plants de fleurs et de légumes"@fr .

<http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Einzelhandel mit Topf- und Schnittblumen\n- Einzelhandel mit Pflanzen\n- Einzelhandel mit Zier- und Obstbäumen und -sträuchern sowie mehrjährigen Pflanzen\n- Einzelhandel mit Setzlingen von Blumen und Gemüse"@de .

<http://classif-mcp.local/i14y/noga2025/477602/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- commercio al dettaglio di fiori in vaso o recisi\n- commercio al dettaglio di piante\n- commercio al dettaglio di alberi e arbusti ornamentali o da frutto e di piante pluriennali\n- commercio al dettaglio di piantine di fiori e ortaggi"@it .

<http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- growing of flowers, see 011900"@en .

<http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la culture de fleurs, voir 011900"@fr .

<http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Anbau von Blumen, siehe 011900"@de .

<http://classif-mcp.local/i14y/noga2025/477602/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- coltivazione di fiori, cfr. 011900"@it .

