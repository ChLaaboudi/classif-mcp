    skos:prefLabel "Anbau von sonstigen ein- und zweijährigen Pflanzen"@de ;
    skos:prefLabel "Coltivazione di altre colture agricole non permanenti"@it .

<http://classif-mcp.local/i14y/noga2025/011900> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
