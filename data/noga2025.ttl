    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- installation of glass, mirrors, etc."@en .

<http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- l'installation de verre, de miroirs, etc."@fr .

<http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Ausführung von Glaserarbeiten, einschliesslich Einbau von Spiegeln usw."@de .

<http://classif-mcp.local/i14y/noga2025/433403/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- posa in opera (installazione) di vetrate, specchi, eccetera"@it .

<http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- installation of windows, see 433202"@en .

<http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- l'installation de fenêtres, voir 433202"@fr .

<http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Einbau von Fenstern, siehe 433202"@de .

<http://classif-mcp.local/i14y/noga2025/433403/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- installazione di finestre, cfr. 433202"@it .

<http://classif-mcp.local/i14y/noga2025/4335> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "4335" ;
    skos:prefLabel "Other building completion and finishing"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/433> ;
    skos:prefLabel "Autres travaux de finition"@fr ;
    skos:prefLabel "Sonstiger Ausbau"@de ;
    skos:prefLabel "Altri lavori di completamento e finitura degli edifici"@it .

<http://classif-mcp.local/i14y/noga2025/433500> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "433500" ;
    skos:prefLabel "Other building completion and finishing"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4335> ;
    skos:prefLabel "Autres travaux de finition"@fr ;
    skos:prefLabel "Sonstiger Ausbau"@de ;
    skos:prefLabel "Altri lavori di completamento e finitura degli edifici"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes the finishing work which concludes the construction of a building.\n\nThis type includes:\n- installation of prefabricated metal sheets, steel parts, profiles, etc.\n- ornamentation fitting works on buildings\n- cladding for exterior walls\n- erection of curtain walls\n- other building completion and finishing work n.e.c."@en .

<http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend les travaux de finition qui concluent la construction d'un bâtiment.\n\nCe genre comprend :\n- l'installation de tôles préfabriquées, de pièces en acier, de profilés, etc.\n- les travaux d'ornementation des bâtiments\n- le revêtement des murs extérieurs\n- le montage de murs-rideaux\n- les autres travaux d'achèvement et de finition de bâtiments n.c.a."@fr .

<http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst Fertigstellungsarbeiten, mit denen der Bau eines Gebäudes abgeschlossen wird.\n\nDiese Art umfasst:\n- Montage von vorgefertigten Blechen, Stahlteilen, Profilen usw.\n- Verzierungsarbeiten an Gebäuden\n- Verkleidung von Aussenwänden\n- Errichtung von Vorhangfassaden\n- sonstige Fertigstellungs- und Ausbauarbeiten an Gebäuden a. n. g."@de .

<http://classif-mcp.local/i14y/noga2025/433500/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include i lavori di finitura che completano la costruzione di un edificio.\n\nQuesto genere include:\n- installazione di lastre metalliche prefabbricate, parti in acciaio, profili, eccetera \n- lavori ornamentali per edifici \n- rivestimenti per pareti esterne \n- posa in opera di facciate continue (curtain walls) \n- altri lavori di completamento e finitura di edifici n.c.a."@it .

<http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- installation of large-scale shelving (e.g. in shops, or warehouses (not an integral part of the building)), see 332000\n- installation of acoustic panels, tiles and similar materials, see 432300\n- interior design activities, see 741300\n- general interior cleaning of buildings and other structures, see 812100\n- specialised interior and exterior cleaning of buildings, see 812202\n- steam cleaning, sandblasting and similar activities for building exteriors, see 812202"@en .

<http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- l'installation de rayonnages à grande échelle (par ex. dans des magasins ou des entrepôts (ne faisant pas partie intégrante du bâtiment)), voir 332000\n- l'installation de panneaux acoustiques, de carreaux et de matériaux similaires, voir 432300\n- les activités d'aménagement intérieur, voir 741300\n- le nettoyage intérieur général de bâtiments et d'autres structures, voir 812100\n- le nettoyage intérieur et extérieur spécialisé de bâtiments, voir 812202\n- le nettoyage à la vapeur, sablage et activités similaires pour l'extérieur des bâtiments, voir 812202"@fr .

<http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Einbau von Grossregalen (z. B. in Geschäften oder Lagerhallen (nicht Bestandteil eines Gebäudes)), siehe 332000\n- Einbau von Akustikplatten, Fliesen und ähnlichen Materialien, siehe 432300\n- Innenraumdesign, siehe 741300\n- allgemeine Innenreinigung von Gebäuden und anderen Bauwerken, siehe 812100\n- spezialisierte Innen- und Aussenreinigung von Gebäuden, siehe 812202\n- Dampfreinigung, Sandstrahlen und ähnliche Tätigkeiten für Gebäudeaussenflächen, siehe 812202"@de .

<http://classif-mcp.local/i14y/noga2025/433500/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- installazione di scaffalature di grandi dimensioni, ad esempio in negozi o magazzini (non come parte integrante degli edifici), cfr. 332000 \n- installazione di pannelli e piastrelle acustici, e materiali simili, cfr. 432300 \n- attività di progettazione di interni, cfr. 741300 \n- pulizia generale interna di edifici e altre strutture, cfr. 812100\n- pulizia specializzata interna ed esterna di edifici, cfr. 812202\n- pulizia a vapore, sabbiatura e attività simili per pareti esterne di edifici, cfr. 812202"@it .

<http://classif-mcp.local/i14y/noga2025/434> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "434" ;
    skos:prefLabel "Specialised construction activities in construction of buildings"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/43> ;
