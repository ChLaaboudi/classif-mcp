    skos:broader <http://classif-mcp.local/i14y/noga2025/9621> ;
    skos:prefLabel "Coiffure et activités de barbier"@fr ;
    skos:prefLabel "Frisör- und Barbiersalons"@de ;
    skos:prefLabel "Servizi di parrucchieri e barbieri"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/962100/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/962100/note/inclusionNote/fr> ;
