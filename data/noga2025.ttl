    skos:prefLabel "Growing of rice"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/011> ;
    skos:prefLabel "Culture du riz"@fr ;
    skos:prefLabel "Anbau von Reis"@de ;
    skos:prefLabel "Coltivazione di riso"@it .

<http://classif-mcp.local/i14y/noga2025/011200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "011200" ;
    skos:prefLabel "Growing of rice"@en ;
