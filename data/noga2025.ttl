    skos:notation "0220" ;
    skos:prefLabel "Logging"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/022> ;
    skos:prefLabel "Exploitation forestière"@fr ;
    skos:prefLabel "Holzeinschlag"@de ;
    skos:prefLabel "Utilizzo di aree forestali"@it .

<http://classif-mcp.local/i14y/noga2025/022000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "022000" ;
    skos:prefLabel "Logging"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/0220> ;
    skos:prefLabel "Exploitation forestière"@fr ;
    skos:prefLabel "Holzeinschlag"@de ;
    skos:prefLabel "Utilizzo di aree forestali"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- production of roundwood for forest-based manufacturing industries\n- production of roundwood used in an unprocessed form (e.g. pit-props, fence posts, utility poles)"@en .

<http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la production de bois rond pour les industries de transformation des produits forestiers\n- la production de bois rond utilisé sous une forme brute (par ex. le bois de mine, les pieux de clôtures et les poteaux électriques)"@fr .

<http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Erzeugung von Stammholz für die Holzverarbeitung\n- Erzeugung von Rohholz (z. B. für Grubenstützen, Zaunpfähle, Leitungsmasten)"@de .

<http://classif-mcp.local/i14y/noga2025/022000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- produzione di tronchi (tondame) per industrie del settore (industrie manifatturiere forestali)\n- produzione di tronchi (tondame) utilizzati in forma non lavorata, quali puntelli da miniera, per recinti o altra paleria"@it .

<http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- gathering and production of forest harvesting residues (e.g. brushwood, stumps, wood chips from logging, other forest waste for energy)\n- production of charcoal in the forest (using traditional methods)"@en .

<http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- la collecte et la production de résidus de l'exploitation forestière (par ex. les broussailles, les souches, les copeaux de bois provenant de l'exploitation forestière, d'autres déchets forestiers destinés à la production d'énergie)\n- la production de charbon de bois en forêt (à l'aide de méthodes traditionnelles)"@fr .

<http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Sammeln und Gewinnung von Holzernterückständen (z. B. Reisig, Baumstümpfe, Hackschnitzel aus Holzeinschlag, sonstige Waldabfälle zur Energieerzeugung)\n- Erzeugung von Holzkohle im Wald (mit traditionellen Methoden)"@de .

<http://classif-mcp.local/i14y/noga2025/022000/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- raccolta e produzione di residui di raccolta boschiva, ad esempio sottobosco, ceppi di legname, trucioli di legname e altri rifiuti forestali per la produzione di energia\n- produzione di carbone nella foresta (utilizzando metodi tradizionali)"@it .

<http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- growing of Christmas trees, see 012900\n- growing of standing timber: planting, replanting, transplanting, thinning and conserving of forests, and timber tracts, see 021000\n- gathering of wild growing non-wood forest products, see 023000\n- production of wood chips and particles, not associated with forestry activities, see 161100\n- production of charcoal through distillation of wood, see 201400"@en .

<http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la culture d'arbres de Noël, voir 012900\n- la production de bois sur pied: boisement, reboisement, transplantation, éclaircie et conservation des forêts, et terrains forestiers, voir 021000\n- la récolte des produits forestiers autres que du bois et poussant à l'état sauvage, voir 023000\n- la production de copeaux et de particules de bois, non associée à des activités forestières, voir 161100\n- la production de charbon de bois par distillation du bois, voir 201400"@fr .

<http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Forstung von Weihnachtsbäumen, siehe 012900\n- Erzeugung von Stammholz: Erstaufforstung, Wiederaufforstung, Verpflanzung, Durchforstung und allgemeine Waldpflege, siehe 021000\n- Sammeln von wild wachsendem Waldmaterial, nicht aus Holz, siehe 023000\n- Erzeugung von Holzhackschnitzeln und -spänen, nicht mit forstwirtschaftlichen Tätigkeiten verbunden, siehe 161100\n- Erzeugung von Holzkohle durch Holzdestillation, siehe 201400"@de .

<http://classif-mcp.local/i14y/noga2025/022000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- coltivazione di alberi di Natale, cfr. 012900\n- arboricoltura forestale: rimboschimento, trapianto, diradamento e conservazione di foreste e aree boschive, cfr. 021000\n- raccolta di prodotti forestali selvatici non legnosi, cfr. 023000\n- produzione di trucioli e particelle di legno, non connessa ad attività forestali, cfr. 161100\n- produzione di carbone tramite distillazione del legno, cfr. 201400"@it .

<http://classif-mcp.local/i14y/noga2025/023> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
