    skos:prefLabel "Malerei und Glaserei"@de ;
    skos:prefLabel "Tinteggiatura e posa in opera di vetri"@it .

<http://classif-mcp.local/i14y/noga2025/433401> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "433401" ;
    skos:prefLabel "Painting"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4334> ;
    skos:prefLabel "Peinture"@fr ;
    skos:prefLabel "Malerei"@de ;
    skos:prefLabel "Tinteggiatura"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- interior and exterior painting of buildings\n\n- painting of civil engineering structures"@en .

<http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la peinture intérieure et extérieure de bâtiments\n- la peinture sur des ouvrages de génie civil"@fr .

<http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Innen- und Aussenanstrich von Gebäuden\n- Anstrich von Tiefbauten"@de .

<http://classif-mcp.local/i14y/noga2025/433401/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- tinteggiatura interna ed esterna di edifici\n- verniciatura di strutture di ingegneria civile"@it .

<http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- coating of metals on buildings and civil engineering structures"@en .

<http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- le revêtement des métaux sur les bâtiments et les ouvrages de génie civil"@fr .

<http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Beschichtung von Metallen auf Gebäuden und Bauwerken"@de .

<http://classif-mcp.local/i14y/noga2025/433401/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- rivestimento in metallo su edifici e strutture di ingegneria civile"@it .

<http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- waterproofing of roofs, see 434102\n- road painting and other marking of streets, see 435000"@en .

<http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- l'imperméabilisation des toits, voir 434102\n- la peinture sur les routes et autres marquages de rues, voir 435000"@fr .

<http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Abdichtung von Dächern, siehe 434102\n- Fahrbahnanstriche und andere Strassenmarkierungen, siehe 435000"@de .

<http://classif-mcp.local/i14y/noga2025/433401/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- lavori di impermeabilizzazione di tetti, cfr. 434102\n- verniciatura di strade e di altra segnaletica stradale, cfr. 435000"@it .

<http://classif-mcp.local/i14y/noga2025/433402> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "433402" ;
    skos:prefLabel "Painting and plastering equally combined"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4334> ;
    skos:prefLabel "Peinture et plâtrerie sans prédominance"@fr ;
    skos:prefLabel "Malerei und Gipserei ohne ausgeprägten Schwerpunkt"@de ;
    skos:prefLabel "Tinteggiatura e intonacatura senza predominanza"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- interior and exterior painting of buildings combined with plastering"@en .

<http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la peinture intérieure et extérieure de bâtiments combinée à la plâtrerie"@fr .

<http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Innen- und Aussenanstrich von Gebäuden in Kombination mit Verputzarbeiten"@de .

<http://classif-mcp.local/i14y/noga2025/433402/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- tinteggiatura interna ed esterna di edifici combinata con l'intonacatura"@it .

<http://classif-mcp.local/i14y/noga2025/433403> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "433403" ;
    skos:prefLabel "Glazing"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4334> ;
