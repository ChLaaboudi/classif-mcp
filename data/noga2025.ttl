<http://classif-mcp.local/i14y/noga2025/264000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "264000" ;
    skos:prefLabel "Manufacture of consumer electronics"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2640> ;
    skos:prefLabel "Fabrication de produits électroniques grand public"@fr ;
    skos:prefLabel "Herstellung von Geräten der Unterhaltungselektronik"@de ;
    skos:prefLabel "Fabbricazione di prodotti di elettronica di consumo"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/264000/note/inclusionNote> ;
