    skos:prefLabel "Fabrication de roulements et de transmissions mécaniques"@fr ;
    skos:prefLabel "Herstellung von Lagern, Getrieben, Zahnrädern und Antriebselementen"@de ;
    skos:prefLabel "Fabbricazione di cuscinetti, ingranaggi e organi di trasmissione"@it .

<http://classif-mcp.local/i14y/noga2025/281500> a skos:Concept ;
