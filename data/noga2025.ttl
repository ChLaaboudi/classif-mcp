    skos:prefLabel "Fabrication de vêtements de dessous pour hommes et garçons"@fr ;
    skos:prefLabel "Herstellung von Wäsche für Männer und Jungen"@de ;
    skos:prefLabel "Fabbricazione di biancheria intima per uomo e ragazzo"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of underwear and nightwear, other than knitted or crocheted (e.g. underpants, briefs, pyjamas, nightdresses, dressing gowns, slips, swimwear)"@en .

<http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication de sous-vêtements et de vêtements de nuit, autres qu'en bonneterie (par ex. caleçons, slips, pyjamas, chemises de nuit, robes de chambre, maillots de bain)"@fr .

<http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von gewebter Unterwäsche und Nachtwäsche, ausgenommen solche aus Gestricken oder Gewirken (z. B. Unterhosen, Schlafanzüge, Nachthemden, Hausmäntel, Slips, Badebekleidung)"@de .

<http://classif-mcp.local/i14y/noga2025/142201/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di biancheria intima e da notte in tessuto, diversa da quella a maglia, ad esempio mutande, slip, pigiami, camicie da notte, vestaglie, sottovesti, costumi da bagno"@it .

<http://classif-mcp.local/i14y/noga2025/142202> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "142202" ;
    skos:prefLabel "Manufacture of ladies’ and girls’ underwear"@en ;
