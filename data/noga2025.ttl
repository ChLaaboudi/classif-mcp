    skos:prefLabel "Reparatur und Instandhaltung von elektrischen Ausrüstungen"@de ;
    skos:prefLabel "Riparazione e manutenzione di apparecchiature elettriche"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/331400/note/inclusionNote> ;
