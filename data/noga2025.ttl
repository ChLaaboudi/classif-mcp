    skos:prefLabel "Commerce de gros de café, thé, cacao et épices"@fr ;
    skos:prefLabel "Grosshandel mit Kaffee, Tee, Kakao und Gewürzen"@de ;
    skos:prefLabel "Commercio all’ingrosso di caffè, tè, cacao e spezie"@it ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/463700/note/exclusionNote> ;
