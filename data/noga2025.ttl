    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- growing of citrus fruits, e.g.:\n\n • grapefruit and pomelo\n\n • lemons and limes\n\n • oranges\n\n • tangerines, mandarins and clementines"@en .

<http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la culture d'agrumes, par ex. :\n\n • pamplemousse et pomelo\n\n • citrons et limes\n\n • oranges\n\n • mandarines, tangerines et clémentines"@fr .

<http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Anbau von Zitrusfrüchten, z. B.:\n  • Grapefruits und Pampelmusen\n  • Zitronen und Limetten\n  • Orangen\n  • Tangerinen, Mandarinen und Clementinen"@de .

<http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- coltivazione di agrumi, quali:\n• pompelmo\n• limoni e lime\n• arance\n• mandarini tangerini, mandarini e clementine"@it .

<http://classif-mcp.local/i14y/noga2025/0124> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "0124" ;
    skos:prefLabel "Growing of pome fruits and stone fruits"@en ;
