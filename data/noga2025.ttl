    skos:prefLabel "Travaux de finition"@fr ;
    skos:prefLabel "Sonstiger Ausbau"@de ;
    skos:prefLabel "Completamento e finitura di edifici"@it .

<http://classif-mcp.local/i14y/noga2025/4331> a skos:Concept ;
