    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "4950" ;
    skos:prefLabel "Transport via pipeline"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/495> ;
    skos:prefLabel "Transport par conduites"@fr ;
    skos:prefLabel "Transport in Rohrfernleitungen"@de ;
    skos:prefLabel "Trasporto mediante condotte"@it .

<http://classif-mcp.local/i14y/noga2025/495000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "495000" ;
    skos:prefLabel "Transport via pipeline"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4950> ;
    skos:prefLabel "Transport par conduites"@fr ;
    skos:prefLabel "Transport in Rohrfernleitungen"@de ;
    skos:prefLabel "Trasporto mediante condotte"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- transport of gases, liquids, water, slurry and other commodities via pipelines\n- pipeline transport of natural gas from processing plants to local distribution systems"@en .

<http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- le transport de gaz, de liquides, d'eau, de boues et d'autres marchandises par conduites\n- le transport par gazoduc du gaz naturel depuis les usines de traitement jusqu'aux systèmes de distribution locaux"@fr .

<http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Transport von Gas, Flüssigkeiten, Wasser, Schlämmen und anderen Gütern in Rohrfernleitungen\n- Transport von Erdgas in Rohrfernleitungen von den Verarbeitungsanlagen zu den lokalen Verteilernetzen"@de .

<http://classif-mcp.local/i14y/noga2025/495000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- trasporto di gas, liquidi, acqua, impasti liquidi e altri prodotti mediante condotte\n- trasporto di gas naturale mediante condotte dagli impianti di trattamento ai sistemi di distribuzione locali"@it .

<http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- operation of pump stations for transport via pipelines"@en .

<http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- l'exploitation de stations de pompage pour le transport par conduites"@fr .

<http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Betrieb von Pumpstationen für den Transport in Rohrfernleitungen"@de .

<http://classif-mcp.local/i14y/noga2025/495000/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- gestione delle stazioni di pompaggio"@it .

<http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- distribution of gaseous fuels, steam or water to end users through local or regional network of mains, see 352200, 353000, 360000\n\n- distribution of water by trucks, see 360000\n\n- retail sale of automotive fuel, see 4730\n\n- transport of liquids by trucks, see 494100"@en .

<http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la distribution de combustibles gazeux, de vapeur ou d'eau aux utilisateurs finaux par le biais d'un réseau local ou régional de conduites, voir 352200, 353000, 360000\n- la distribution d'eau par camions, voir 360000\n- le commerce de détail de carburant automobile, voir 4730\n- le transport de liquides par camions, voir 494100"@fr .

<http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Verteilung von gasförmigen Brennstoffen, Dampf oder Wasser an Endverbraucher über lokale oder regionale Leitungsnetze, siehe 352200, 353000, 360000\n- Wasserversorgung durch Lastkraftwagen, siehe 360000\n- Einzelhandel mit Kraftstoffen, siehe 4730\n- Transport von Flüssigkeiten mit Lastkraftwagen, siehe 494100"@de .

<http://classif-mcp.local/i14y/noga2025/495000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- distribuzione di combustibili gassosi, vapore o acqua agli utenti finali attraverso una rete di distribuzione locale o regionale, cfr. 352200, 353000, 360000\n- distribuzione di acqua mediante autocarri, cfr. 360000\n- commercio al dettaglio di carburanti per autotrazione, cfr. 4730\n- trasporto di liquidi mediante autocarri, cfr. 494100"@it .

<http://classif-mcp.local/i14y/noga2025/50> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "50" ;
    skos:prefLabel "Water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/H> ;
    skos:prefLabel "Transport par eau"@fr ;
    skos:prefLabel "Schifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e per vie d’acqua interne"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This division includes the water transport of passengers or freight, whether scheduled or not, whether for professional, personal or recreational reasons. Also included are the operation of towing or pushing boats, excursion or sightseeing boats, cruise ships, ferries, water taxis, and so on. Although the location is an indicator for the separation between sea and inland water transport, the deciding factor is the type of vessel used. Transport on seagoing vessels is classified in groups 501 and 502, while transport using other vessels is classified in groups 503 and 504."@en .

<http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Cette division comprend le transport par eau de passagers ou de marchandises, régulier ou non, pour des raisons professionnelles, personnelles ou récréatives. Elle comprend également l'exploitation de bateaux de remorquage ou de poussage, de bateaux d'excursion ou de tourisme, de bateaux de croisière, de ferries, de bateaux-taxis, etc. Bien que le lieu soit un indicateur de la séparation entre le transport maritime et le transport fluvial, le facteur décisif est le type de navire utilisé. Le transport sur des navires de mer est classé dans les groupes 501 et 502, tandis que le transport utilisant d'autres navires est classé dans les groupes 503 et 504."@fr .

<http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Abteilung umfasst die Personen- und Güterbeförderung zu Wasser, im Linien- oder Gelegenheitsverkehr, unabhängig davon, ob die Beförderung aus beruflichen, persönlichen oder Freizeitgründen erfolgt. Dazu gehört auch der Betrieb von Schlepp- oder Schubschiffen, Ausflugs-, Besichtigungs- und Kreuzfahrtschiffen, Fähren, Wassertaxis usw. Zwar lässt der Einsatzort Rückschlüsse auf die Unterscheidung zwischen einerseits Hochsee- und Küstenschifffahrt und andererseits Binnenschifffahrt zu, ausschlaggebend jedoch ist die Art des eingesetzten Wasserfahrzeugs. Die Beförderung auf Hochsee- und Küstenschiffen wird in die Gruppen 501 und 502 eingeordnet, die Beförderung auf anderen Schiffen hingegen in die Gruppen 503 und 504."@de .

<http://classif-mcp.local/i14y/noga2025/50/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questa divisione include il trasporto per vie d'acqua (vie d'acqua marittime o interne) di passeggeri o merci, di linea e non, per motivi professionali, personali o ricreativi. Sono incluse anche le operazioni di traino o spinta di imbarcazioni, le attività di imbarcazioni per escursioni, crociere o battelli panoramici, traghetti, taxi d'acqua, eccetera.\nSebbene la localizzazione delle vie d'acqua sia un indicatore per la separazione tra trasporto marittimo e trasporto per vie d'acqua interne, il fattore decisivo è il tipo di imbarcazione (nave o natante) utilizzata.\nIl trasporto tramite imbarcazioni marittime è classificato nei gruppi 501 e 502, mentre il trasporto tramite altre imbarcazioni è classificato nei gruppi 503 e 504."@it .

<http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This division excludes restaurant and bar activities aboard ships, if carried out by separate units, see 561101, 563001"@en .

<http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Cette division ne comprend pas les activités de restauration et de bar à bord des navires, si elles sont exercées par des unités distinctes, voir 561101, 563001"@fr .

<http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Abteilung umfasst nicht den Betrieb von Restaurants und Bars an Bord von Schiffen, sofern dieser durch eigenenständige Unternehmen erfolgt, siehe 561101, 563001."@de .

<http://classif-mcp.local/i14y/noga2025/50/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questa divisione non include i servizi di ristorazione e bar a bordo di imbarcazioni se forniti da altre unità diverse da quelle che effettuano il trasporto, cfr. 561101, 563001"@it .

<http://classif-mcp.local/i14y/noga2025/501> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "501" ;
    skos:prefLabel "Sea and coastal passenger water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/50> ;
    skos:prefLabel "Transports maritimes et côtiers de passagers"@fr ;
    skos:prefLabel "Personenbeförderung in der Hochsee- und Küstenschifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e costiero di passeggeri"@it ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote/it> .

<http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group also includes:\n- transport of passengers on lakes, etc., when similar types of vessels are used as on sea or coastal waters"@en .

<http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce groupe comprend également :\n- le transport de passagers sur des lacs, etc., lorsque des types de bateaux similaires à ceux utilisés en mer ou dans les eaux côtières sont utilisés"@fr .

<http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Gruppe umfasst ferner:\n- Personenbeförderung auf Seen usw., sofern ähnliche Wasserfahrzeuge wie auf Hochsee- oder Küstengewässern eingesetzt werden"@de .

<http://classif-mcp.local/i14y/noga2025/501/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo gruppo include inoltre:\n- le attività di trasporto di passeggeri in laghi e altre vie d'acqua interne quando vengono utilizzate imbarcazioni simili a quelle marittime"@it .

<http://classif-mcp.local/i14y/noga2025/5010> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "5010" ;
    skos:prefLabel "Sea and coastal passenger water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/501> ;
    skos:prefLabel "Transports maritimes et côtiers de passagers"@fr ;
    skos:prefLabel "Personenbeförderung in der Hochsee- und Küstenschifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e costiero di passeggeri"@it .

<http://classif-mcp.local/i14y/noga2025/501000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "501000" ;
    skos:prefLabel "Sea and coastal passenger water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/5010> ;
    skos:prefLabel "Transports maritimes et côtiers de passagers"@fr ;
    skos:prefLabel "Personenbeförderung in der Hochsee- und Küstenschifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e costiero di passeggeri"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- transport of passengers over seas and coastal waters, whether scheduled or not:\n • operation of excursion, cruise or sightseeing boats\n • operation of ferries, water taxis, etc.\n- operation of other passenger sea or coastal transport"@en .

<http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- le transport de passagers en mer et dans les eaux côtières, qu'il soit régulier ou non :\n • exploitation de bateaux d'excursion, de croisière ou de tourisme\n • exploitation de ferries, de taxis nautiques, etc.\n- l'exploitation d'autres transports maritimes ou côtiers de passagers"@fr .

<http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Personenbeförderung in der Hochsee- und Küstenschifffahrt, im Linien- oder Gelegenheitsverkehr:\n  • Betrieb von Ausflugs-, Besichtigungs- und Kreuzfahrtschiffen\n  • Betrieb von Fähren, Wassertaxis usw.\n- Betrieb von sonstigen Personenbeförderungsmitteln in der Hochsee- und Küstenschifffahrt"@de .

<http://classif-mcp.local/i14y/noga2025/501000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- trasporto di linea e non di linea, di passeggeri su imbarcazioni progettate per navigare in mare aperto e in acque costiere:\n • gestione di imbarcazioni per escursioni, crociere o visite turistiche (piroscafi o natanti panoramici)\n • gestione di traghetti, lance-taxi, eccetera\n- gestione di altri trasporti marittimi o costieri di passeggeri"@it .

<http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- rental of pleasure boats with crew for sea and coastal water transport (e.g. for fishing trips)\n- ferry transport of passengers with or without a vehicle"@en .

<http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- la location de bateaux de plaisance avec équipage pour le transport maritime et côtier (par ex. pour les croisières de pêche)\n- le transport par ferry de passagers avec ou sans véhicule"@fr .

<http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Vermietung von Vergnügungsschiffen mit Besatzung für die Hochsee- und Küstenschifffahrt (z. B. für Angelausflüge)\n- Fährtransporte von Personen mit oder ohne Fahrzeug, in der Hochsee- und Küstenschifffahrt"@de .

<http://classif-mcp.local/i14y/noga2025/501000/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- noleggio di imbarcazioni da diporto con equipaggio per il trasporto marino o costiero, ad esempio per escursioni con attività di pesca a bordo (battute di pesca)\n- trasporto di passeggeri in traghetto con o senza veicolo al seguito"@it .

<http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- restaurant and bar activities aboard ships, when provided by separate units, see 5611, 563001\n- rental of pleasure boats and yachts without crew, see 772100\n- rental of commercial ships or boats without crew, see 773400\n- operation of floating casinos, not transporting passengers, see 920000"@en .

<http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- les activités de restauration et de bar à bord des navires, lorsqu'elles sont assurées par des unités distinctes, voir 5611, 563001\n- la location de bateaux de plaisance et de navires sans équipage, voir 772100\n- la location de navires ou de bateaux commerciaux sans équipage, voir 773400\n- l'exploitation de casinos flottants, ne transportant pas de passagers, voir 920000"@fr .

<http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Betrieb von Restaurants und Bars an Bord von Schiffen, sofern dieser durch eigenständige Unternehmen erfolgt, siehe 5611, 563001\n- Vermietung von Vergnügungsschiffen und -yachten, ohne Besatzung, siehe 772100\n- Vermietung von Handelsschiffen und -booten, ohne Besatzung, siehe 773400\n- Betrieb von \"schwimmenden Casinos\", ohne Personenbeförderung, siehe 920000"@de .

<http://classif-mcp.local/i14y/noga2025/501000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- servizi di ristorazione e bar a bordo di imbarcazioni se forniti da altre unità diverse da quelle che effettuano il trasporto, cfr. 5611, 563001\n- noleggio e leasing operativo di imbarcazioni da diporto e yacht senza equipaggio, cfr. 772100\n- noleggio di navi e imbarcazioni adibite a operazioni commerciali senza equipaggio, cfr. 773400\n- gestione di casinò galleggianti che non trasportano passeggeri, cfr. 920000"@it .

<http://classif-mcp.local/i14y/noga2025/502> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "502" ;
    skos:prefLabel "Sea and coastal freight water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/50> ;
    skos:prefLabel "Transports maritimes et côtiers de fret"@fr ;
    skos:prefLabel "Güterbeförderung in der Hochsee- und Küstenschifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e costiero di merci"@it ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote/it> .

<http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group also includes:\n- transport of freight on lakes, etc., when similar types of vessels are used as on sea or coastal waters"@en .

<http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce groupe comprend également :\n- le transport de marchandises sur des lacs, etc., lorsque des types de bateaux similaires à ceux utilisés en mer ou dans les eaux côtières sont utilisés"@fr .

<http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Gruppe umfasst ferner:\n- Güterbeförderung auf Seen usw., sofern ähnliche Wasserfahrzeuge wie auf Hochsee- oder Küstengewässern eingesetzt werden"@de .

<http://classif-mcp.local/i14y/noga2025/502/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "È incluso anche il trasporto di merci in laghi e altre vie d'acqua interne, quando vengono utilizzate imbarcazioni simili a quelle marittime."@it .

<http://classif-mcp.local/i14y/noga2025/5020> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "5020" ;
    skos:prefLabel "Sea and coastal freight water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/502> ;
    skos:prefLabel "Transports maritimes et côtiers de fret"@fr ;
    skos:prefLabel "Güterbeförderung in der Hochsee- und Küstenschifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e costiero di merci"@it .

<http://classif-mcp.local/i14y/noga2025/502000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "502000" ;
    skos:prefLabel "Sea and coastal freight water transport"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/5020> ;
    skos:prefLabel "Transports maritimes et côtiers de fret"@fr ;
    skos:prefLabel "Güterbeförderung in der Hochsee- und Küstenschifffahrt"@de ;
    skos:prefLabel "Trasporto marittimo e costiero di merci"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- transport of freight over sea and coastal waters\n\n- transport by towing or pushing of barges, oil rigs, etc."@en .

<http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- le transport de marchandises en mer et sur les eaux côtières\n\n- le transport par remorquage ou poussage de barges, de plates-formes pétrolières, etc."@fr .

<http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Güterbeförderung in der Hochsee- und Küstenschifffahrt, im Linien- oder Gelegenheitsverkehr\n- Betrieb von Schlepp- und Schubschiffen, Bohrinseln usw."@de .

<http://classif-mcp.local/i14y/noga2025/502000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- trasporto, di linea e non di linea, di merci in mare aperto e in acque costiere\n- trasporto, mediante rimorchiatori o spintori, di chiatte, piattaforme petrolifere, eccetera"@it .

<http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- rental of vessels with crew for sea and coastal freight water transport\n\n- ferry transport of unaccompanied vehicles"@en .

<http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- la location de navires avec équipage pour le transport maritime et côtier de marchandises\n\n- le transport par ferry de véhicules non accompagnés"@fr .

<http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Vermietung von Schiffen mit Besatzung für die Güterbeförderung in der Hochsee- und Küstenschifffahrt\n- Fährtransport von Fahrzeugen ohne Fahrer"@de .

<http://classif-mcp.local/i14y/noga2025/502000/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- noleggio di imbarcazioni con equipaggio per il trasporto marittimo e costiero di merci\n- trasporto su traghetto di veicoli non accompagnati"@it .

<http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- ferry transport of passengers with or without a vehicle, see 501000\n- storage of freight, see 521000\n- harbour operations and other auxiliary activities (e.g. docking, pilotage, lighterage, vessel salvage), see 522200\n- cargo handling, see 522400\n- rental of commercial ships or boats without crew, see 773400"@en .

<http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- le transport par ferry de passagers avec ou sans véhicule, voir 501000\n- le stockage de marchandises, voir 521000\n- l'exploitation des ports et autres activités auxiliaires (par ex. accostage, pilotage, allègement, sauvetage des navires), voir 522200\n- la manutention de marchandises, voir 522400\n- location de navires ou de bateaux commerciaux sans équipage, voir 773400"@fr .

<http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Fähren zur Beförderung von Personen mit oder ohne Fahrzeug, siehe 501000\n- Lagerung von Frachtgut, siehe 521000\n- Hafenbetrieb und andere Hafentätigkeiten (z. B. Docken, Lotsendienst, Leichterung, Bergung von Schiffen), siehe 522200\n- Frachtumschlag, siehe 522400\n- Vermietung von Handelsschiffen und Booten, ohne Besatzung, siehe 773400"@de .

<http://classif-mcp.local/i14y/noga2025/502000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- il trasporto di passeggeri in traghetto con o senza veicolo al seguito, cfr. 501000\n- magazzinaggio di merci, cfr. 521000\n- attività portuali e altre attività ausiliarie quali attracco, pilotaggio, segnalazione marittima, recupero marittimo, cfr. 522200\n- movimentazione merci, cfr. 522400\n- noleggio di navi e imbarcazioni adibite a operazioni commerciali senza equipaggio, cfr. 773400"@it .

