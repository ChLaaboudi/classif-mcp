    skos:prefLabel "Attività di orti botanici e giardini zoologici"@it .

<http://classif-mcp.local/i14y/noga2025/914100> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "914100" ;
    skos:prefLabel "Botanical and zoological garden activities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/9141> ;
    skos:prefLabel "Activités de gestion de jardins botaniques et zoologiques"@fr ;
    skos:prefLabel "Botanische und zoologische Gärten"@de ;
    skos:prefLabel "Attività di orti botanici e giardini zoologici"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/914100/note/inclusionNote> ;
