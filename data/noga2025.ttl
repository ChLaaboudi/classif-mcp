    skos:prefLabel "Dachstuhlarbeiten"@de ;
    skos:prefLabel "Lavori di carpenteria"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/434101/note/inclusionNote> ;
