    skos:broader <http://classif-mcp.local/i14y/noga2025/4775> ;
    skos:prefLabel "Autre commerce de détail de parfumerie et de produits de beauté"@fr ;
    skos:prefLabel "Sonstiger Einzelhandel mit kosmetischen Erzeugnissen und Körperpflegemitteln"@de ;
    skos:prefLabel "Altro commercio al dettaglio di cosmetici e di articoli di profumeria"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477502/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477502/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477502/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/477502/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/477502/note/exclusionNote> ;
