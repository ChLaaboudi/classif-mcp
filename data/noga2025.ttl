    skos:prefLabel "Allevamento di altri bovini e bufalini"@it .

<http://classif-mcp.local/i14y/noga2025/014200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "014200" ;
    skos:prefLabel "Raising of other cattle and buffaloes"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/0142> ;
    skos:prefLabel "Élevage d’autres bovins et de buffles"@fr ;
    skos:prefLabel "Haltung von sonstigen Rindern"@de ;
    skos:prefLabel "Allevamento di altri bovini e bufalini"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/014200/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/014200/note/inclusionNote/fr> ;
