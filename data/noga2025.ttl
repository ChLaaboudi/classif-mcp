    skos:prefLabel "Activités de relations publiques et de communication"@fr ;
    skos:prefLabel "Public-Relations-Beratung"@de ;
    skos:prefLabel "Pubbliche relazioni e comunicazione"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/733000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/733000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/733000/note/inclusionNote/de> ;
