    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote/it> .

<http://classif-mcp.local/i14y/noga2025/014200/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- raising and breeding of cattle and buffaloes for meat\n\n- production of bovine semen of meat breeds"@en .

<http://classif-mcp.local/i14y/noga2025/014200/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- l'élevage et la reproduction de bovins et de buffles pour la viande\n\n- la production de semence bovine de races à viande"@fr .

<http://classif-mcp.local/i14y/noga2025/014200/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Zucht und Haltung von Schlachtrindern und -büffeln\n- Erzeugung von Rindersperma von Fleischrassen"@de .

<http://classif-mcp.local/i14y/noga2025/014200/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- allevamento e riproduzione di bovini e bufalini da carne\n- produzione di sperma bovino di razze da carne"@it .

<http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- raising and breeding of draft cattle or buffaloes\n\n- raising and breeding of fighting bulls"@en .

<http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- l'élevage de bovins de trait ou de buffles\n- l'élevage et la reproduction de taureaux de combat"@fr .

<http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Zucht und Haltung von Zugrindern oder -büffeln\n- Zucht und Haltung von Kampfstieren"@de .

<http://classif-mcp.local/i14y/noga2025/014200/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- allevamento e riproduzione di bovini e bufalini da tiro\n- allevamento e riproduzione di tori da combattimento"@it .

<http://classif-mcp.local/i14y/noga2025/0143> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "0143" ;
