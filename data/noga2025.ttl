    skos:broader <http://classif-mcp.local/i14y/noga2025/743> ;
    skos:prefLabel "Activités de traduction et d’interprétation"@fr ;
    skos:prefLabel "Übersetzen und Dolmetschen"@de ;
    skos:prefLabel "Attività di traduzione e interpretariato"@it .

<http://classif-mcp.local/i14y/noga2025/743000> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "743000" ;
    skos:prefLabel "Translation and interpretation activities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/7430> ;
    skos:prefLabel "Activités de traduction et d’interprétation"@fr ;
    skos:prefLabel "Übersetzen und Dolmetschen"@de ;
    skos:prefLabel "Attività di traduzione e interpretariato"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- translation and interpretation of all languages, including sign language, whether spoken or written"@en .

<http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la traduction et l'interprétation de toutes les langues, y compris la langue des signes, qu'elles soient parlées ou écrites"@fr .

<http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Übersetzen und Dolmetschen aller Sprachen, einschliesslich der Gebärdensprache, in Wort und Schrift"@de .

<http://classif-mcp.local/i14y/noga2025/743000/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- traduzione e interpretariato in qualsiasi lingua, incluso linguaggio dei segni, sia in forma parlata sia in forma scritta"@it .

<http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- publishing translation software, see 582900\n\n- development of translation tools and training translation engines, see 621000\n\n- language teaching activities, see 855901"@en .

<http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la publication de logiciels de traduction, voir 582900\n- le développement d'outils de traduction et la formation de moteurs de traduction, voir 621000\n- les activités d'enseignement des langues, voir 855901"@fr .

<http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Verlegen von Übersetzungssoftware, siehe 582900\n- Entwicklung von Übersetzungshilfen und Übersetzungsprogrammen, siehe 621000\n- Sprachunterricht, siehe 855901"@de .

<http://classif-mcp.local/i14y/noga2025/743000/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- edizione di software per traduzioni, cfr. 582900\n- sviluppo di strumenti di traduzione e addestramento dei motori di traduzione, cfr. 621000\n- insegnamento di lingue straniere, cfr. 855901"@it .

