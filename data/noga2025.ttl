<http://classif-mcp.local/i14y/noga2025/472100> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "472100" ;
    skos:prefLabel "Retail sale of fruit and vegetables"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4721> ;
