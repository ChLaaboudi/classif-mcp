<http://classif-mcp.local/i14y/noga2025/464902/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- le commerce de gros de tricycles, de voitures à pédales"@fr .

<http://classif-mcp.local/i14y/noga2025/464902/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Grosshandel mit Dreirädern, Tretautos"@de .

<http://classif-mcp.local/i14y/noga2025/464902/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n\n- vendita all'ingrosso di tricicli, auto a pedali"@it .

<http://classif-mcp.local/i14y/noga2025/464903> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "464903" ;
    skos:prefLabel "Wholesale of sports goods"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/4649> ;
    skos:prefLabel "Commerce de gros d'articles de sport"@fr ;
    skos:prefLabel "Grosshandel mit Sportartikeln"@de ;
    skos:prefLabel "Commercio all'ingrosso di articoli sportivi"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/464903/note/inclusionNote> ;
