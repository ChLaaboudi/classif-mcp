    skos:prefLabel "Produzione di combustibili solidi da biomassa vegetale"@it .

<http://classif-mcp.local/i14y/noga2025/162600> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "162600" ;
