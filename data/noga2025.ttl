    skos:prefLabel "Enseignement de la conduit"@fr ;
    skos:prefLabel "Fahr- und Flugschulen"@de ;
    skos:prefLabel "Attività di scuole guida"@it ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/855300/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/855300/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/855300/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/855300/note/additionalContentNote/it> ;
