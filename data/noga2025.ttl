    skos:prefLabel "Transports aériens de fret et transports spatiaux"@fr ;
    skos:prefLabel "Güterbeförderung in der Luftfahrt und Raumtransport"@de ;
    skos:prefLabel "Trasporto aereo di merci e trasporto spaziale"@it .

