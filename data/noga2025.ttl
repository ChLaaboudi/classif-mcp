<http://classif-mcp.local/i14y/noga2025/741400/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- design of computer-produced graphics for animations, see 591100"@en .

<http://classif-mcp.local/i14y/noga2025/741400/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
