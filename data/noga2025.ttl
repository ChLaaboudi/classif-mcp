    skos:prefLabel "Autre transport terrestre de voyageurs n.c.a."@fr ;
    skos:prefLabel "Sonstige Personenbeförderung im Landverkehr a. n. g."@de ;
    skos:prefLabel "Altri trasporti terrestri di passeggeri n.c.a."@it ;
