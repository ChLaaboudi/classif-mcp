    skos:prefLabel "Stockage de gaz dans le cadre de services d’approvisionnement en réseau"@fr ;
    skos:prefLabel "Speichern von Gas zu Versorgungszwecken"@de ;
    skos:prefLabel "Stoccaggio di gas nell’ambito dei servizi di fornitura della rete"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/352400/note/inclusionNote> ;
