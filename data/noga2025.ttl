<http://classif-mcp.local/i14y/noga2025/591400> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "591400" ;
    skos:prefLabel "Motion picture projection activities"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/5914> ;
    skos:prefLabel "Projection de films cinématographiques"@fr ;
    skos:prefLabel "Kinos"@de ;
    skos:prefLabel "Attività di proiezione cinematografica"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- activities of motion picture or audiovisual projection in cinemas, in open air or other projection venues"@en .

<http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- les activités de projection cinématographique ou audiovisuelle dans les cinémas, en plein air ou dans d'autres lieux de projection"@fr .

<http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Vorführung von Spielfilmen oder anderen audiovisuellen Werken in Kinos, im Freien oder in sonstigen Vorführräumen"@de .

<http://classif-mcp.local/i14y/noga2025/591400/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- attività di proiezione cinematografica o audiovisiva nelle sale cinematografiche (nei cinema), all'aperto o in altre sale di proiezione"@it .

