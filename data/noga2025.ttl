    skos:prefLabel "Vermietung von Maschinen, Geräten und sonstigen beweglichen Sachen"@de ;
    skos:prefLabel "Noleggio e leasing operativo di altre macchine, attrezzature e beni materiali"@it .

<http://classif-mcp.local/i14y/noga2025/7731> a skos:Concept ;
