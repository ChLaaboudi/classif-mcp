    skos:prefLabel "Autres activités de service de réservation et activités connexes"@fr ;
    skos:prefLabel "Erbringung sonstiger Reservierungsdienstleistungen"@de ;
    skos:prefLabel "Altri servizi di prenotazione e attività connesse"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/799000/note/inclusionNote> ;
