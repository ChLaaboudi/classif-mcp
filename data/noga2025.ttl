    skos:broader <http://classif-mcp.local/i14y/noga2025/222> ;
    skos:prefLabel "Fabrication d’emballages en matières plastiques"@fr ;
    skos:prefLabel "Herstellung von Verpackungsmitteln aus Kunststoffen"@de ;
    skos:prefLabel "Fabbricazione di imballaggi in materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "222200" ;
    skos:prefLabel "Manufacture of plastic packing goods"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2222> ;
    skos:prefLabel "Fabrication d’emballages en matières plastiques"@fr ;
    skos:prefLabel "Herstellung von Verpackungsmitteln aus Kunststoffen"@de ;
    skos:prefLabel "Fabbricazione di imballaggi in materie plastiche"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- manufacture of plastic articles for the packing of goods:\n\n • plastic bags, sacks, containers, boxes, cases, carboys, bottles, etc."@en .

<http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication d'articles en plastique pour l'emballage de marchandises :\n • sacs, sachets, conteneurs, boîtes, caisses, bonbonnes, bouteilles, etc."@fr .

<http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Verpackungsmitteln aus Kunststoffen:\n  • Beutel, Säcke, Behällter, Schachteln, Kisten, Ballons, Flaschen usw., aus Kunststoff"@de .

<http://classif-mcp.local/i14y/noga2025/222200/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di imballaggi in materie plastiche:\n • sacchetti, sacchi, contenitori, scatole, casse, bottiglioni, bottiglie, eccetera"@it .

<http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- manufacture of luggage and handbags of plastic, see 151200"@en .

<http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la fabrication de bagages et de sacs à main en plastique, voir 151200"@fr .

<http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Reisegepäck und Handtaschen aus Kunststoff, siehe 151200"@de .

<http://classif-mcp.local/i14y/noga2025/222200/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di articoli da viaggio e borse in materie plastiche, cfr. 151200"@it .

<http://classif-mcp.local/i14y/noga2025/2223> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2223" ;
    skos:prefLabel "Manufacture of doors and windows of plastic"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/222> ;
    skos:prefLabel "Fabrication de portes et fenêtres en matières plastiques"@fr ;
    skos:prefLabel "Herstellung von Türen und Fenstern aus Kunststoffen"@de ;
    skos:prefLabel "Fabbricazione di porte e finestre in materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222300> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "222300" ;
    skos:prefLabel "Manufacture of doors and windows of plastic"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2223> ;
    skos:prefLabel "Fabrication de portes et fenêtres en matières plastiques"@fr ;
    skos:prefLabel "Herstellung von Türen und Fenstern aus Kunststoffen"@de ;
    skos:prefLabel "Fabbricazione di porte e finestre in materie plastiche"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of doors, windows and their frames of plastic\n- manufacture of multi-material doors and windows with the frame made of plastic\n- manufacture of shutters, blinds (including venetian blinds) and similar articles, and parts thereof, made of plastic\n- manufacture of multi-material shutters for doors and windows with the frame made of plastic"@en .

<http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la fabrication de portes, de fenêtres et de leurs cadres en plastique\n\n- la fabrication de portes et de fenêtres multi-matériaux dont le cadre est en plastique\n\n- la fabrication de volets, de stores (y compris les stores vénitiens) et d'articles similaires et de leurs parties, en matière plastique\n\n- la fabrication de volets multi-matériaux pour portes et fenêtres dont le cadre est en plastique"@fr .

<http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Türen, Fenstern und deren Rahmen aus Kunststoffen\n- Herstellung von Türen und Fenstern aus mehreren Materialien mit Rahmen aus Kunststoff\n- Herstellung von Fensterläden, Jalousien (einschliesslich Lamellenvorhängen) und ähnlichen Waren und Teilen davon, aus Kunststoff\n- Herstellung von Tür- und Fensterläden aus mehreren Materialien mit Rahmen aus Kunststoff"@de .

<http://classif-mcp.local/i14y/noga2025/222300/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di porte, finestre e relativi telai in materie plastiche\n- fabbricazione di porte e finestre multimateriale con telai in materie plastiche\n- fabbricazione di imposte (persiane), tapparelle (incluse veneziane) e articoli simili e loro parti, in materie plastiche\n- fabbricazione di imposte (persiane) multimateriale per porte e finestre con telai in materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/2224> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2224" ;
    skos:prefLabel "Manufacture of builders’ ware of plastic"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/222> ;
    skos:prefLabel "Fabrication d’éléments en matières plastiques pour la construction"@fr ;
    skos:prefLabel "Herstellung von Baubedarfsartikeln aus Kunststoffen"@de ;
    skos:prefLabel "Fabbricazione di articoli in materie plastiche per l’edilizia"@it .

<http://classif-mcp.local/i14y/noga2025/222400> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "222400" ;
    skos:prefLabel "Manufacture of builders’ ware of plastic"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2224> ;
    skos:prefLabel "Fabrication d’éléments en matières plastiques pour la construction"@fr ;
    skos:prefLabel "Herstellung von Baubedarfsartikeln aus Kunststoffen"@de ;
    skos:prefLabel "Fabbricazione di articoli in materie plastiche per l’edilizia"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of builders’ plastics ware:\n • skirting boards\n • tanks, reservoirs\n • plastic floor, wall or ceiling coverings in rolls or in the form of tiles, etc.\n • plastic sanitaryware like plastic baths, shower baths, washbasins, lavatory pans, flushing cisterns, etc.\n- manufacture of resilient floor coverings (e.g. vinyl, linoleum)"@en .

<http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication d'articles en plastique pour le bâtiment :\n • plinthes\n • citernes, réservoirs\n • revêtements de sol, de mur ou de plafond en plastique, en rouleaux ou sous forme de carreaux, etc.\n • articles sanitaires en plastique tels que les baignoires, les douches, les lavabos, les cuvettes de WC, les réservoirs de chasse d'eau, etc.\n - la fabrication de revêtements de sol souples (par ex. vinyle, linoléum)"@fr .

<http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Baubedarfsartikeln aus Kunststoffen:\n  • Sockelleisten\n  • Tanks, Sammelbehälter\n  • Bodenbeläge, Wand- oder Deckenverkleidungen aus Kunststoff in Rollen oder in Form von Fliesen oder Platten usw.\n  • Waren aus Kunststoff zu sanitären oder hygienischen Zwecken wie Kunststoffbadewannen, -duschen, -waschbecken, -klosettschüsseln, -spülkästen usw.\n- Herstellung von elastischen Fussbodenbelägen (z. B. Vinyl, Linoleum)"@de .

<http://classif-mcp.local/i14y/noga2025/222400/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di articoli per l'edilizia in materie plastiche, quali:\n • battiscopa\n • cisterne, serbatoi\n • rivestimenti in materie plastiche per pavimenti, pareti o soffitti in rotoli o sotto forma di piastrelle, eccetera\n • articoli sanitari in materie plastiche quali vasche da bagno, vasche da doccia, lavabi, lavatoi, cassette di scarico, eccetera\n- fabbricazione di rivestimenti resilienti per pavimenti, ad esempio vinile, linoleum"@it .

<http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- manufacture of sanitary ware made out of a mixture of plastics and minerals, with the minerals serving as a filler"@en .

<http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- la fabrication d'articles sanitaires fabriqués à partir d'un mélange de matières plastiques et de minéraux, les minéraux servant de remplisseur"@fr .

<http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von Waren zu sanitären oder hygienischen Zwecken bestehend aus einer Mischung von Kunststoffen und Mineralien, wobei die Mineralien als Füllstoff dienen"@de .

<http://classif-mcp.local/i14y/noga2025/222400/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- fabbricazione di sanitari realizzati con una miscela di plastica e minerali, con i minerali che fungono da riempitivo"@it .

<http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- manufacture of rubber floors, see 221200\n\n- manufacture of doors and windows of plastic, see 222300"@en .

<http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la fabrication de sols en caoutchouc, voir 221200\n\n- la fabrication de portes et fenêtres en plastique, voir 222300"@fr .

<http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Fussböden aus Kautschuk, siehe 221200\n- Herstellung von Türen und Fenstern aus Kunststoff, siehe 222300"@de .

<http://classif-mcp.local/i14y/noga2025/222400/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di pavimenti in gomma, cfr. 221200\n- fabbricazione di porte e finestre in materie plastiche, cfr. 222300"@it .

<http://classif-mcp.local/i14y/noga2025/2225> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2225" ;
    skos:prefLabel "Processing and finishing of plastic products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/222> ;
    skos:prefLabel "Façonnage et finition de produits en matières plastiques"@fr ;
    skos:prefLabel "Bearbeitung und Veredlung von Kunststoffwaren"@de ;
    skos:prefLabel "Lavorazione e finitura di prodotti in materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222500> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "222500" ;
    skos:prefLabel "Processing and finishing of plastic products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2225> ;
    skos:prefLabel "Façonnage et finition de produits en matières plastiques"@fr ;
    skos:prefLabel "Bearbeitung und Veredlung von Kunststoffwaren"@de ;
    skos:prefLabel "Lavorazione e finitura di prodotti in materie plastiche"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes general activities for the processing and finishing of plastic products, typically carried out on a fee or contract basis:\n- processing of plastics (e.g. by cutting, chamfering, turning, milling, drilling, threading by computer numerical control (CNC) or other machineries)\n- bending, gluing and welding of plastic materials\n- processing of plastic surfaces (e.g. by engraving, sandblasting, microblasting, polishing)\n- coating of plastic surfaces (e.g. painting, varnishing and metallisation of plastics)"@en .

<http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend les activités générales de transformation et de finition des produits en plastique, généralement exercées pour le compte de tiers :\n- la transformation des matières plastiques (par ex. découpage, chanfreinage, tournage, fraisage, perçage, filetage à l'aide d'une commande numérique par ordinateur (CNC) ou d'autres machines)\n- le cintrage, le collage et le soudage de matières plastiques\n- le traitement des surfaces en plastique (par ex. gravure, sablage, microbillage, polissage)\n- le revêtement de surfaces en plastique (par ex. peinture, vernissage et métallisation des matières plastiques)"@fr .

<http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst allgemeine Tätigkeiten zur Bearbeitung und Veredelung von Kunststofferzeugnissen, die typischerweise im Lohnauftrag durchgeführt werden:\n- Bearbeitung von Kunststoffen (z. B. durch Schneiden, Abschrägen, Drehen, Fräsen, Bohren, Gewindeschneiden mit Hilfe von computergesteuerten (CNC) oder anderen Maschinen)\n- Biegen, Kleben und Schweissen von Kunststoffen\n- Bearbeiten von Kunststoffoberflächen (z. B. durch Gravieren, Sandstrahlen, Mikrostrahlen, Polieren)\n- Beschichten von Kunststoffoberflächen (z. B. Streichen, Lackieren und Metallisieren von Kunststoffen)"@de .

<http://classif-mcp.local/i14y/noga2025/222500/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include attività generali per la lavorazione e la finitura di prodotti in materie plastiche, tipicamente su commissione o su base remunerativa o contrattuale (per conto terzi).\n- lavorazione di materie plastiche, ad esempio mediante taglio, smussatura, tornitura, fresatura, foratura, filettatura con macchine a controllo numerico (CNC) o altre macchine\n- piegatura, incollaggio e saldatura di materiali plastici\n- lavorazione di superfici in plastica, ad esempio mediante incisione, sabbiatura, microsabbiatura, lucidatura\n- rivestimento di superfici in plastica, ad esempio tinteggiatura, verniciatura e metallizzazione di materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- cladding of metal pipes with plastics\n- welding of plastic tanks and pipes\n- metal coating of plastics"@en .

<http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- le revêtement de tuyaux métalliques avec des matières plastiques\n- le soudage de réservoirs et de tuyaux en plastique\n- le revêtement métallique des matières plastiques"@fr .

<http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Ummanteln von Metallrohren mit Kunststoffen\n- Schweissen von Kunststofftanks und -rohren\n- Metallisches Beschichten von Kunststoffen"@de .

<http://classif-mcp.local/i14y/noga2025/222500/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- rivestimento di tubi metallici con materie plastiche\n- saldatura di serbatoi e tubi in plastica\n- rivestimento in metallo di materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- plastic coating of metal surfaces, see 255100"@en .

<http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- le revêtement plastique de surfaces métalliques, voir 255100"@fr .

<http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Kunststoffbeschichtung von Metalloberflächen, siehe 255100"@de .

<http://classif-mcp.local/i14y/noga2025/222500/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- rivestimento in materie plastiche di superfici metalliche, cfr. 255100"@it .

<http://classif-mcp.local/i14y/noga2025/2226> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2226" ;
    skos:prefLabel "Manufacture of other plastic products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/222> ;
    skos:prefLabel "Fabrication d’autres articles en matières plastiques"@fr ;
    skos:prefLabel "Herstellung von sonstigen Kunststoffwaren"@de ;
    skos:prefLabel "Fabbricazione di altri prodotti in materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222600> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "222600" ;
    skos:prefLabel "Manufacture of other plastic products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2226> ;
    skos:prefLabel "Fabrication d’autres articles en matières plastiques"@fr ;
    skos:prefLabel "Herstellung von sonstigen Kunststoffwaren"@de ;
    skos:prefLabel "Fabbricazione di altri prodotti in materie plastiche"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of plastic tableware, kitchenware and toilet articles\n- manufacture of diverse plastic products, e.g.:\n • plastic headgear excluding safety headgear, insulating fittings, parts of light fittings, office or school supplies, articles of apparel, fittings for furniture, statuettes, transmission and conveyer belts, plastic shoe-lasts, plastic cigar and cigarette holders, combs, plastic hair curlers, plastic novelties\n- manufacture of products from polymer clay"@en .

<http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication d'articles de table, de cuisine et de toilette en plastique\n- la fabrication de produits en plastique divers, par ex. :\n • casques en plastique sauf les casques de sécurité, pièces isolantes, parties d'appareils d'éclairage, fournitures de bureau ou scolaires, articles d'habillement, garnitures pour meubles, statuettes, courroies de transmission, bandes transporteuses, bandes autocollantes en plastique, formes à chaussures en plastique, porte-cigares et porte-cigarettes en plastique, peignes, bigoudis en plastique, gadgets en plastique\n- la fabrication de produits à base d’argile polymère"@fr .

<http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Geschirr und anderen Artikeln für den Tisch- oder Küchengebrauch sowie Toilettengegenständen aus Kunststoff\n- Herstellung von verschiedenen Kunststoffwaren, z. B.:\n• Kopfbedeckungen aus Kunststoff, ausgenommen Sicherheitskopfbedeckungen, Isolierteile, Teile zur Ausstattung von Beleuchtungskörpern, Büro- oder Schulartikel, Bekleidung, Beschläge für Möbel, Statuetten, Treibriemen und Förderbänder, Schuhleisten aus Kunststoff, Zigarren- und Zigarettenspitzen aus Kunststoff, Kämme, Lockenwickler aus Kunststoff, Dekorations- und Scherzartikel aus Kunststoff\n- Herstellung von Erzeugnissen aus Polymer-Ton"@de .

<http://classif-mcp.local/i14y/noga2025/222600/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di stoviglie, utensili da cucina e articoli di profumeria in materie plastiche\n- fabbricazione di diversi prodotti in plastica, ad esempio:\n • copricapi in plastica (esclusi copricapi di sicurezza), pezzi isolanti, parti staccate di apparecchi per l'illuminazione, articoli di abbigliamento, guarnizioni per mobili, statuette, cinghie di trasmissione e nastri trasportatori, bocchini in plastica per sigari e sigarette, bigodini, oggettistica varia\n- fabbricazione di prodotti in argilla polimerica"@it .

<http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- manufacture of plastic equipment for cleaning"@en .

<http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- la fabrication de matériel de nettoyage en plastique"@fr .

<http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von Reinigungsgeräten aus Kunststoff"@de .

<http://classif-mcp.local/i14y/noga2025/222600/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- fabbricazione di attrezzature per la pulizia in materie plastiche"@it .

<http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- manufacture of plastic luggage, see 151200\n- manufacture of plastic footwear, see 152000\n- manufacture of plastic furniture, see 3100\n- manufacture of mattresses of uncovered cellular plastic, see 310009\n- manufacture of plastic sports requisites, see 323000\n- manufacture of plastic games and toys, see 324000\n- manufacture of plastic medical and dental appliances, see 325002\n- manufacture of plastic ophthalmic goods, see 325003\n- manufacture of plastic safety headgear and other personal safety equipment of plastics, see 329900"@en .

<http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la fabrication de bagages en plastique, voir 151200\n- la fabrication de chaussures en plastique, voir 152000\n- la fabrication de meubles en plastique, voir 3100\n- la fabrication de matelas en plastique alvéolaire non recouvert, voir 310009\n- la fabrication d'articles de sport en plastique, voir 323000\n- la fabrication de jeux et de jouets en plastique, voir 324000\n- la fabrication d'appareils médicaux et dentaires en plastique, voir 325002\n- la fabrication d'articles ophtalmiques en plastique, voir 325003\n- la fabrication de casques de sécurité et d'autres équipements de sécurité personnel en plastique, voir 329900"@fr .

<http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Reisegepäck aus Kunststoff, siehe 151200\n- Herstellung von Schuhen aus Kunststoff, siehe 152000\n- Herstellung von Kunststoffmöbeln, siehe 3100\n- Herstellung von Auflegematratzen aus nicht überzogenem Zellkautschuk, siehe 310009\n- Herstellung von Sportgeräten aus Kunststoff, siehe 323000\n- Herstellung von Spielen und Spielzeug aus Kunststoff, siehe 324000\n- Herstellung von medizinischen und zahnmedizinischen Apparaten und Geräten aus Kunststoff, siehe 325002\n- Herstellung von Brillen, Haftschalen, Augenarzt- und Optikerbedarf aus Kunststoff, siehe 325003\n- Herstellung von Sicherheitskopfbedeckungen und anderer persönlicher Sicherheitsausrüstung aus Kunststoffen, siehe 329900"@de .

<http://classif-mcp.local/i14y/noga2025/222600/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di articoli da viaggio in materie plastiche, cfr. 151200\n- fabbricazione di calzature in materie plastiche, cfr. 152000\n- fabbricazione di mobili in materie plastiche, cfr. 310000\n- fabbricazione di materassi in plastica alveolare non rivestiti, cfr. 310009\n- fabbricazione di articoli sportivi in materie plastiche, cfr. 323000\n- fabbricazione di giochi e giocattoli in materie plastiche, cfr. 324000\n- fabbricazione di apparecchi in materie plastiche per uso medico e odontoiatrico, cfr. 325002\n- fabbricazione di articoli oftalmici in materie plastiche, cfr. 325003\n- fabbricazione di copricapi di sicurezza in plastica e di altri dispositivi di sicurezza personale in plastica, cfr. 329900"@it .

<http://classif-mcp.local/i14y/noga2025/23> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "23" ;
    skos:prefLabel "Manufacture of other non-metallic mineral products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/C> ;
    skos:prefLabel "Fabrication d’autres produits minéraux non métalliques"@fr ;
    skos:prefLabel "Herstellung von Glas und Glaswaren, Keramik, Verarbeitung von Steinen und Erden"@de ;
    skos:prefLabel "Fabbricazione di altri prodotti della lavorazione di minerali non metalliferi"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote/it> .

<http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This division includes manufacturing activities related to a single substance of mineral origin. This division includes the manufacture of glass and glass products (for example, flat glass, hollow glass, fibres, technical glassware), ceramic products, tiles and baked clay products, cement, concrete and plaster, from raw materials to finished articles."@en .

<http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Cette division comprend les activités de fabrication liées à une substance unique d'origine minérale. Cette division comprend la fabrication de verre et de produits en verre (par ex. verre plat, verre creux, fibres, verrerie technique), de produits céramiques, de tuiles et de produits en terre cuite, de ciment, de béton et de plâtre, depuis les matières premières jusqu'aux produits finis."@fr .

<http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Abteilung umfasst Herstellungstätigkeiten, die sich auf einen einzelnen Stoff mineralischen Ursprungs beziehen. Sie umfasst die Herstellung von Glas und Erzeugnissen daraus (z. B. Flachglas, Hohlglas, Glasfasern, technische Glaswaren), keramischen Erzeugnissen, Ziegeln und Erzeugnissen aus gebranntem Ton sowie Zement, Beton und Gips, von den Rohstoffen bis zu den Fertigwaren."@de .

<http://classif-mcp.local/i14y/noga2025/23/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questa divisione include le attività relative alla lavorazione di sostanze singole di origine minerale. Questa divisione include la fabbricazione di vetro e prodotti in vetro (ad esempio vetro piano, vetro cavo, fibre di vetro, vetro tecnico), prodotti ceramici, piastrelle e prodotti in argilla cotta, cemento, calcestruzzo e gesso, dalle materie prime agli articoli finiti."@it .

<http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "The manufacture of shaped and finished stone and other mineral products is also included in this division.\n\nThis division also includes the manufacture of products of composite materials in which glass and non-metallic minerals (for example, sand, gravel, stone or clay) are the predominant material."@en .

<http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "La fabrication de produits façonnés et finis en pierre et autres produits minéraux est également incluse dans cette division.\n\nCette division comprend également la fabrication de produits en matériaux composites dans lesquels le verre et les minéraux non métalliques (par ex. le sable, le gravier, la pierre ou l'argile, sont les matériaux prédominants)."@fr .

<http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Die Herstellung von bearbeiteten und fertigen Steinen und anderen mineralischen Erzeugnissen ist in dieser Abteilung ebenfalls eingeschlossen.\n\nDiese Abteilung umfasst ferner die Herstellung von Erzeugnissen aus Verbundwerkstoffen, bei denen Glas und nichtmetallische Mineralien (z. B. Sand, Kies, Stein oder Ton), die vorherrschenden Materialien sind."@de .

<http://classif-mcp.local/i14y/noga2025/23/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "In questa divisione è inclusa anche la produzione di pietre sagomate e finite e di altri prodotti minerali.\nQuesta divisione include anche la fabbricazione di prodotti di materiali compositi in cui vetro e minerali non metallici, ad esempio sabbia, ghiaia, pietra o argilla, rappresentano i materiali principali."@it .

<http://classif-mcp.local/i14y/noga2025/231> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "231" ;
    skos:prefLabel "Manufacture of glass and glass products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/23> ;
    skos:prefLabel "Fabrication de verre et d’articles en verre"@fr ;
    skos:prefLabel "Herstellung von Glas und Glaswaren"@de ;
    skos:prefLabel "Fabbricazione di vetro e di prodotti in vetro"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group includes glass in all its forms, made by any process, and articles of glass."@en .

<http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce groupe comprend la fabrication de verre sous toutes ses formes, quel que soit le procédé utilisé, et les articles en verre."@fr .

<http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Gruppe umfasst Glas in allen Formen, in beliebigem Verfahren hergestellt, und Waren aus Glas."@de .

<http://classif-mcp.local/i14y/noga2025/231/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo gruppo include la fabbricazione di vetro in tutte le sue forme ottenuto tramite qualsiasi processo, e di prodotti in vetro."@it .

<http://classif-mcp.local/i14y/noga2025/2311> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2311" ;
    skos:prefLabel "Manufacture of flat glass"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/231> ;
    skos:prefLabel "Fabrication de verre plat"@fr ;
    skos:prefLabel "Herstellung von Flachglas"@de ;
    skos:prefLabel "Fabbricazione di vetro piano"@it .

<http://classif-mcp.local/i14y/noga2025/231100> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "231100" ;
    skos:prefLabel "Manufacture of flat glass"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2311> ;
    skos:prefLabel "Fabrication de verre plat"@fr ;
    skos:prefLabel "Herstellung von Flachglas"@de ;
    skos:prefLabel "Fabbricazione di vetro piano"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of flat glass (e.g. cast, rolled, drawn or blown), surface ground or polished glass in sheets and sheets of float glass, opacified, flashed or having an absorbent, reflecting or non-reflecting layer, including wired, coloured throughout the mass or tinted flat glass"@en .

<http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication de verre plat (par ex. coulé, laminé, étiré ou soufflé), de verre dépoli ou poli en feuilles et de feuilles de verre flotté, opacifié, flashé ou comportant une couche absorbante, réfléchissante ou non réfléchissante, y compris le verre plat câblé, coloré dans la masse ou teinté"@fr .

<http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Flachglas (z. B. gegossen, gewalzt, gezogen oder geblasen), auf einer oder beiden Seiten geschliffenes oder poliertes Glas in Platten oder Tafeln und Platten oder Tafeln aus feuerpoliertem Glas (float-glass), undurchsichtig, überfangen, mit einer absorbierenden, reflektierenden oder nicht reflektierenden Schicht, einschliesslich mit Drahteinlagen oder dergleichen verstärktes, in der Masse gefärbtes oder getöntes Flachglas"@de .

<http://classif-mcp.local/i14y/noga2025/231100/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di vetro piano, ad esempio vetro fuso, laminato, trafilato o soffiato, smerigliato o lucidato in superficie in lastre e lastre di vetro float, opacizzato, sommerso o con uno strato assorbente, riflettente o non riflettente, anche cablato, colorato in tutta la massa o vetro piano colorato"@it .

<http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- shaping and processing done as part of the manufacturing process"@en .

<http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- le façonnage et la transformation effectués dans le cadre du processus de fabrication"@fr .

<http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Formen und Verarbeiten im Rahmen des Herstellungsprozesses"@de .

<http://classif-mcp.local/i14y/noga2025/231100/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- attività di sagomatura e lavorazione effettuate nell'ambito del processo di fabbricazione"@it .

<http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- shaping and processing of flat glass sheets (e.g. bending, engraving, laminating, tempering), see 231200"@en .

<http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- le façonnage et la transformation des feuilles de verre plat (par ex. le bombage, la gravure, le feuilletage, la trempe), voir 231200"@fr .

<http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Formen und Verarbeiten von Flachglasplatten oder -tafeln (z. B. Biegen, Gravieren, Laminieren, Vorspannen), siehe 231200"@de .

<http://classif-mcp.local/i14y/noga2025/231100/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- attività di sagomatura e lavorazione di lastre di vetro piano, ad esempio curvatura, incisione, laminazione, formatura, cfr. 231200"@it .

<http://classif-mcp.local/i14y/noga2025/2312> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2312" ;
    skos:prefLabel "Shaping and processing of flat glass"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/231> ;
    skos:prefLabel "Façonnage et transformation du verre plat"@fr ;
    skos:prefLabel "Veredlung und Bearbeitung von Flachglas"@de ;
    skos:prefLabel "Lavorazione e trasformazione del vetro piano"@it .

<http://classif-mcp.local/i14y/noga2025/231200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "231200" ;
    skos:prefLabel "Shaping and processing of flat glass"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2312> ;
    skos:prefLabel "Façonnage et transformation du verre plat"@fr ;
    skos:prefLabel "Veredlung und Bearbeitung von Flachglas"@de ;
    skos:prefLabel "Lavorazione e trasformazione del vetro piano"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of bent, edgeworked, engraved, drilled or enamelled glass sheets or profiles\n- manufacture of toughened or laminated safety glass\n- manufacture of glass mirrors\n- manufacture of multiple-walled insulating glass and units of glass\n- manufacture of coated glass\n- surface treatment of flat glass"@en .

<http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la fabrication de feuilles ou de profilés de verre courbés, façonnés, gravés, percés ou émaillés\n\n- la fabrication de verre de sécurité trempé ou feuilleté\n\n- la fabrication de miroirs en verre\n\n- la fabrication de vitrages isolants à parois multiples et d'unités de verre\n\n- la fabrication de verre à couche\n\n- le traitement de surface du verre plat"@fr .

<http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Glasplatten, -tafeln oder -profilen, gebogen, mit bearbeiteten Kanten, graviert, gelocht oder emailliert\n- Herstellung von vorgespanntem Einschichten- oder von Mehrschichten-Sicherheitsglas (Verbundglas)\n- Herstellung von Spiegeln aus Glas\n- Herstellung von mehrschichtigen Isolierverglasungen und Glaselementen\n- Herstellung von beschichtetem Glas\n- Oberflächenbehandlung von Flachglas"@de .

<http://classif-mcp.local/i14y/noga2025/231200/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di lastre o profili di vetro curvato, bordato, inciso, forato o smaltato\n- fabbricazione di vetro di sicurezza temperato o laminato\n- fabbricazione di specchi in vetro\n- fabbricazione di vetri isolanti a pareti multiple\n- fabbricazione di vetro rivestito\n- trattamento superficiale di vetro piano"@it .

<http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- printing onto glass, see 181209\n\n- manufacture of vehicle mirrors, see 293200"@en .

<http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- l'impression sur verre, voir 181209\n\n- la fabrication de rétroviseurs de véhicules, voir 293200"@fr .

<http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Bedrucken von Glas, siehe 181209\n- Herstellung von Fahrzeugspiegeln, siehe 293200"@de .

<http://classif-mcp.local/i14y/noga2025/231200/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- stampa su vetro, cfr. 181209\n- fabbricazione di specchietti per veicoli, cfr. 293200"@it .

<http://classif-mcp.local/i14y/noga2025/2313> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2313" ;
    skos:prefLabel "Manufacture of hollow glass"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/231> ;
    skos:prefLabel "Fabrication de verre creux"@fr ;
    skos:prefLabel "Herstellung von Hohlglas"@de ;
    skos:prefLabel "Fabbricazione di vetro cavo"@it .

<http://classif-mcp.local/i14y/noga2025/231300> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "231300" ;
    skos:prefLabel "Manufacture of hollow glass"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2313> ;
    skos:prefLabel "Fabrication de verre creux"@fr ;
    skos:prefLabel "Herstellung von Hohlglas"@de ;
    skos:prefLabel "Fabbricazione di vetro cavo"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- manufacture of bottles and other containers of glass or crystal\n\n- manufacture of drinking glasses, glassware for table or kitchen purposes and other domestic glass or crystal articles"@en .

<http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication de bouteilles et autres récipients en verre ou en cristal\n- la fabrication de verres à boire, d'articles en verre pour la table ou la cuisine et d'autres articles à usage domestiques en verre ou en cristal"@fr .

<http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Flaschen und anderen Behältnissen aus Glas oder Kristall\n- Herstellung von Trinkgläsern, Glaswaren zur Verwendung bei Tisch oder in der Küche und sonstigen Haushaltswaren aus Glas oder Kristall"@de .

<http://classif-mcp.local/i14y/noga2025/231300/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di bottiglie e altri contenitori in vetro o cristallo\n- fabbricazione di bicchieri, oggetti in vetro per la tavola o la cucina e altri articoli per la casa in vetro o cristallo"@it .

<http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n\n- manufacture of glass inners for vacuum vessels\n\n- cutting or otherwise decorating drinking glasses"@en .

<http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n\n- la fabrication d'intérieurs en verre pour les récipients sous vide\n\n- la découpe ou la décoration de verres à boire"@fr .

<http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von Glaskolben für Vakuum-Isolierbehälter\n- Schleifen oder anderes Bearbeiten von Trinkgläsern"@de .

<http://classif-mcp.local/i14y/noga2025/231300/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- fabbricazione di interni in vetro per recipienti sottovuoto\n- taglio e altre attività di decorazione di bicchieri in vetro"@it .

<http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- printing onto glass, see 181209\n\n- manufacture of glass toys, see 324000"@en .

<http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- l'impression sur verre, voir 181209\n\n- la fabrication de jouets en verre, voir 324000"@fr .

<http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Bedrucken von Glas, siehe 181209\n- Herstellung von Spielzeug aus Glas, 324000"@de .

<http://classif-mcp.local/i14y/noga2025/231300/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- stampa su vetro, cfr. 181209\n- fabbricazione di giocattoli in vetro, cfr. 324000"@it .

<http://classif-mcp.local/i14y/noga2025/2314> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2314" ;
    skos:prefLabel "Manufacture of glass fibres"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/231> ;
    skos:prefLabel "Fabrication de fibres de verre"@fr ;
    skos:prefLabel "Herstellung von Glasfasern und Waren daraus"@de ;
    skos:prefLabel "Fabbricazione di fibre di vetro"@it .

<http://classif-mcp.local/i14y/noga2025/231400> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "231400" ;
    skos:prefLabel "Manufacture of glass fibres"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2314> ;
    skos:prefLabel "Fabrication de fibres de verre"@fr ;
    skos:prefLabel "Herstellung von Glasfasern und Waren daraus"@de ;
    skos:prefLabel "Fabbricazione di fibre di vetro"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- manufacture of glass fibres, including glass wool and non-woven products thereof\n\n- manufacture of products from glass fibres"@en .

<http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la fabrication de fibres de verre, y compris la laine de verre et les produits non tissés à base de fibres de verre\n\n- la fabrication de produits à partir de fibres de verre"@fr .

<http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Glasfasern, einschliesslich Glaswolle und nicht gewebten Erzeugnissen daraus\n- Herstellung von Erzeugnissen aus Glasfasern"@de .

<http://classif-mcp.local/i14y/noga2025/231400/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di fibre di vetro, inclusa lana di vetro e prodotti non-tessuti in lana di vetro\n- fabbricazione di prodotti in fibre di vetro"@it .

<http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n- manufacture of woven fabrics of glass yarn, see 139600\n- manufacture of slag-wool, rock-wool and similar mineral wools, see 239900\n- manufacture of fibre optic cables for data transmission or live transmission of images, see 273100"@en .

<http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n- la fabrication de tissus de fils de verre, voir 139600\n- la fabrication de laine de laitier, de laine de roche et de laines minérales similaires, voir 239900\n- la fabrication de câbles à fibres optiques pour la transmission de données, voir 273100"@fr .

<http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von Geweben von Garnen aus Glas, siehe 139600\n- Herstellung von Hüttenwolle/Schlackenwolle, Steinwolle und ähnlichen mineralischen Wollen, siehe 239900\n- Herstellung von Kabeln aus optischen Fasern (Glasfaserkabeln) für die Übermittlung von Daten oder die Live-Übermittlung von Bildern, siehe 273100"@de .

<http://classif-mcp.local/i14y/noga2025/231400/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di tessuti di filati di vetro, cfr. 139600\n- fabbricazione di lana di scoria, lana di roccia e lane minerali simili, cfr. 239900\n- fabbricazione di cavi in fibra ottica per la trasmissione di dati o la trasmissione in diretta di immagini, cfr. 273100"@it .

<http://classif-mcp.local/i14y/noga2025/2315> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2315" ;
    skos:prefLabel "Manufacture and processing of other glass, including technical glassware"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/231> ;
    skos:prefLabel "Fabrication et façonnage d’autres articles en verre, y compris verre technique"@fr ;
    skos:prefLabel "Herstellung, Veredlung und Bearbeitung von sonstigem Glas einschliesslich technischen Glaswaren"@de ;
    skos:prefLabel "Fabbricazione e lavorazione di altro vetro incluso il vetro per usi tecnici"@it .

<http://classif-mcp.local/i14y/noga2025/231500> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "231500" ;
    skos:prefLabel "Manufacture and processing of other glass, including technical glassware"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2315> ;
    skos:prefLabel "Fabrication et façonnage d’autres articles en verre, y compris verre technique"@fr ;
    skos:prefLabel "Herstellung, Veredlung und Bearbeitung von sonstigem Glas einschliesslich technischen Glaswaren"@de ;
    skos:prefLabel "Fabbricazione e lavorazione di altro vetro incluso il vetro per usi tecnici"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote/it> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote/fr> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of laboratory, hygienic or pharmaceutical glassware\n- manufacture of clock or watch glass, optical glass and optical elements not optically worked\n- manufacture of glassware used in imitation jewellery\n- manufacture of glass insulators and glass insulating fittings\n- manufacture of glass envelopes for lamps\n- manufacture of glass figurines\n- manufacture of glass blocks and bricks, slabs, squares and tiles, of a kind used for building or construction purposes, and multicellular or foam glass in blocks, panels, plates, shells or similar forms\n- manufacture of glass in rods or tubes"@en .

<http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication d'articles en verre pour laboratoire, l'hygiène ou la pharmacie\n- la fabrication de verre d'horlogerie, de verre optique et d'éléments optiques non travaillés optiquement\n- la fabrication d'articles en verre utilisés dans la bijouterie de fantaisie\n- la fabrication d'isolateurs en verre et de pièces isolantes en verre\n- la fabrication d'enveloppes en verre pour lampes\n- la fabrication de figurines en verre\n- la fabrication de blocs et de briques de verre, de dalles, de carrés et de carreaux de verre, pour une utilisation dans la construction ou le bâtiment, et de verre mousse ou multicellulaire en blocs, panneaux, plaques, coquilles ou autres formes similaires\n- la fabrication de verre en barres ou en tubes"@fr .

<http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Glaswaren für Laboratorien sowie hygienischen oder pharmazeutischen Bedarfsartikeln aus Glas\n- Herstellung von Glas für Uhren, optischem Glas und optisch nicht bearbeiteten optischen Elementen\n- Herstellung von Glaswaren für Modeschmuck\n- Herstellung von Isolatoren und Isolierteilen aus Glas\n- Herstellung von Glaskolben für Lampen\n- Herstellung von Glasfiguren\n- Herstellung von Steinen, Platten, Fliesen und Dachziegeln aus Glas für Bauzwecke sowie von vielzelligem Glas oder Schaumglas in Blöcken, Tafeln, Platten, Schalen oder ähnlichen Formen\n- Herstellung von Glas in Stangen, Stäben oder Rohren"@de .

<http://classif-mcp.local/i14y/noga2025/231500/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di vetrerie per laboratori, per uso igienico, per farmacia\n- fabbricazione di vetri per orologi da muro o da polso, vetro d'ottica ed elementi ottici non lavorati otticamente\n- fabbricazione di vetro utilizzato in bigiotteria\n- fabbricazione di isolatori in vetro e di raccordi isolanti in vetro\n- fabbricazione di involucri in vetro per lampade\n- fabbricazione di statuette in vetro\n- fabbricazione di blocchi e mattoni in vetro, lastre, quadrati e piastrelle, dei tipi utilizzati in edilizia e nelle costruzioni, e in vetro multicellulare o espanso in blocchi, pannelli, lastre, gusci o simili\n- fabbricazione di vetro in barre o tubi"@it .

<http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type also includes:\n- manufacture of glass doors, walls, etc.\n- finishing of other glass, including technical glass (e.g. cutting or mechanically polishing glassware)"@en .

<http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend également :\n- la fabrication de portes en verre, de parois en verre, etc.\n- la finition d'autres verres, y compris le verre technique (par ex. la découpe ou le polissage mécanique d'objets en verre)"@fr .

<http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst ferner:\n- Herstellung von Türen, Wänden usw. aus Glas\n- Veredelung von anderem Glas, einschliesslich technischem Glas (z. B. Schleifen, Schneiden oder mechanisches Polieren von Glaswaren)"@de .

<http://classif-mcp.local/i14y/noga2025/231500/note/additionalContentNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include inoltre:\n- fabbricazione di porte e pareti in vetro, eccetera\n- finitura di altro vetro, incluso vetro tecnico, ad esempio taglio o lucidatura meccanica di oggetti in vetro"@it .

<http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- manufacture of optical elements optically worked, see 267000\n\n- manufacture of syringes and other medical laboratory equipment, see 325009"@en .

<http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la fabrication d'éléments optiques travaillés optiquement, voir 267000\n\n- la fabrication de seringues et d'autres équipements de laboratoire médical, voir 325009"@fr .

<http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von optisch bearbeiteten optischen Elementen, siehe 267000\n- Herstellung von Spritzen und anderer medizinischer Laborausstattung, siehe 325009"@de .

<http://classif-mcp.local/i14y/noga2025/231500/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di elementi ottici lavorati otticamente, cfr. 267000\n- fabbricazione di siringhe e altre attrezzature mediche da laboratorio, cfr. 325009"@it .

<http://classif-mcp.local/i14y/noga2025/232> a skos:Concept ;
