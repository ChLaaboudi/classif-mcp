    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/741300/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/741300/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/741300/note/exclusionNote> ;
