<http://classif-mcp.local/i14y/noga2025/869302/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- consultation and treatment activities of neuropsychologists"@en .

<http://classif-mcp.local/i14y/noga2025/869302/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
