    skos:prefLabel "Location et location-bail de machines et équipements de bureau et d’ordinateurs"@fr ;
    skos:prefLabel "Vermietung von Büromaschinen, Datenverarbeitungsgeräten und -einrichtungen"@de ;
    skos:prefLabel "Noleggio e leasing operativo di macchine, attrezzature e computer per ufficio"@it .

<http://classif-mcp.local/i14y/noga2025/773300> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "773300" ;
    skos:prefLabel "Rental and leasing of office machinery, equipment and computers"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/7733> ;
    skos:prefLabel "Location et location-bail de machines et équipements de bureau et d’ordinateurs"@fr ;
    skos:prefLabel "Vermietung von Büromaschinen, Datenverarbeitungsgeräten und -einrichtungen"@de ;
    skos:prefLabel "Noleggio e leasing operativo di macchine, attrezzature e computer per ufficio"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/773300/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/773300/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/773300/note/inclusionNote/de> ;
