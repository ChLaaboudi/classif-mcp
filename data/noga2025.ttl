<http://classif-mcp.local/i14y/noga2025/434201/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- damp proofing and water proofing works"@en .

<http://classif-mcp.local/i14y/noga2025/434201/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- les travaux d'étanchéité et d'imperméabilisation"@fr .

<http://classif-mcp.local/i14y/noga2025/434201/note/inclusionNote/de> a xkos:ExplanatoryNote ;
