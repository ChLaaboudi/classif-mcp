    skos:prefLabel "Herstellung von Tapeten"@de ;
    skos:prefLabel "Fabbricazione di carta da parati"@it .

<http://classif-mcp.local/i14y/noga2025/172400> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "172400" ;
    skos:prefLabel "Manufacture of wallpaper"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/1724> ;
    skos:prefLabel "Fabrication de papiers peints"@fr ;
    skos:prefLabel "Herstellung von Tapeten"@de ;
    skos:prefLabel "Fabbricazione di carta da parati"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/172400/note/inclusionNote> ;
