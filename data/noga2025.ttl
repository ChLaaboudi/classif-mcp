    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/855/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/855/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/855/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/855/note/exclusionNote/fr> ;
