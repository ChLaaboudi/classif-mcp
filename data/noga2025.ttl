<http://classif-mcp.local/i14y/noga2025/012300> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "012300" ;
    skos:prefLabel "Growing of citrus fruits"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/0123> ;
    skos:prefLabel "Culture d’agrumes"@fr ;
    skos:prefLabel "Anbau von Zitrusfrüchten"@de ;
    skos:prefLabel "Coltivazione di agrumi"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/012300/note/inclusionNote/fr> ;
