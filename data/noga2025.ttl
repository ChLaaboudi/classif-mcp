<http://classif-mcp.local/i14y/noga2025/731200> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "731200" ;
    skos:prefLabel "Media representation"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/7312> ;
    skos:prefLabel "Régie publicitaire de médias"@fr ;
    skos:prefLabel "Vermarktung und Vermittlung von Werbezeiten und Werbeflächen"@de ;
    skos:prefLabel "Attività di concessionarie pubblicitarie"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/731200/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/731200/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/731200/note/inclusionNote/de> ;
