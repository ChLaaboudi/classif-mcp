    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/464903/note/additionalContentNote/de> ;
    xkos:additionalContentNote <http://classif-mcp.local/i14y/noga2025/464903/note/additionalContentNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/464903/note/exclusionNote> ;
