    skos:notation "2343" ;
    skos:prefLabel "Manufacture of ceramic insulators and insulating fittings"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/234> ;
    skos:prefLabel "Fabrication d’isolateurs et pièces isolantes en céramique"@fr ;
    skos:prefLabel "Herstellung von Isolatoren und Isolierteilen aus Keramik"@de ;
    skos:prefLabel "Fabbricazione di isolatori e di pezzi isolanti in ceramica"@it .

<http://classif-mcp.local/i14y/noga2025/234300> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "234300" ;
    skos:prefLabel "Manufacture of ceramic insulators and insulating fittings"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2343> ;
    skos:prefLabel "Fabrication d’isolateurs et pièces isolantes en céramique"@fr ;
    skos:prefLabel "Herstellung von Isolatoren und Isolierteilen aus Keramik"@de ;
    skos:prefLabel "Fabbricazione di isolatori e di pezzi isolanti in ceramica"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n\n- manufacture of electrical insulators and insulating fittings for electrical purposes, of ceramics"@en .

<http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n\n- la fabrication d'isolateurs électriques et de pièces isolantes pour l'électricité, en céramique"@fr .

<http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von elektrischen Isolatoren und Isolierteilen für elektrotechnische Zwecke, aus Keramik"@de .

<http://classif-mcp.local/i14y/noga2025/234300/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di isolatori elettrici e di raccordi isolanti per usi elettrici in ceramica"@it .

<http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- manufacture of refractory ceramic goods, see 232000"@en .

<http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la fabrication de produits céramiques réfractaires, voir 232000"@fr .

<http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von feuerfesten keramischen Erzeugnissen, siehe 232000"@de .

<http://classif-mcp.local/i14y/noga2025/234300/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di prodotti ceramici refrattari, cfr. 232000"@it .

<http://classif-mcp.local/i14y/noga2025/2344> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "2344" ;
    skos:prefLabel "Manufacture of other technical ceramic products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/234> ;
    skos:prefLabel "Fabrication d’autres produits céramiques à usage technique"@fr ;
    skos:prefLabel "Herstellung von keramischen Erzeugnissen für sonstige technische Zwecke"@de ;
    skos:prefLabel "Fabbricazione di altri prodotti in ceramica per uso tecnico e industriale"@it .

<http://classif-mcp.local/i14y/noga2025/234400> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
    skos:notation "234400" ;
    skos:prefLabel "Manufacture of other technical ceramic products"@en ;
    skos:broader <http://classif-mcp.local/i14y/noga2025/2344> ;
    skos:prefLabel "Fabrication d’autres produits céramiques à usage technique"@fr ;
    skos:prefLabel "Herstellung von keramischen Erzeugnissen für sonstige technische Zwecke"@de ;
    skos:prefLabel "Fabbricazione di altri prodotti in ceramica per uso tecnico e industriale"@it ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote/fr> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote/de> ;
    xkos:inclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote/it> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote/fr> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote/de> ;
    xkos:exclusionNote <http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote/it> .

<http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type includes:\n- manufacture of permanent magnets and articles intended to become permanent magnets after magnetisation, of materials other than metal (e.g. agglomerated ferrite)\n- manufacture of ceramic wares for laboratory, chemical or other technical uses"@en .

<http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre comprend :\n- la fabrication d'aimants permanents et d'articles destinés à devenir des aimants permanents après magnétisation, en matériaux autres que le métal (par ex. ferrite agglomérée)\n- la fabrication d'articles en céramique destinés aux laboratoires, à l'industrie chimique ou à d'autres usages techniques"@fr .

<http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst:\n- Herstellung von Dauermagneten und Waren, die dazu bestimmt sind, nach Magnetisierung zu Dauermagneten zu werden, aus anderen Werkstoffen als Metall (z. B. agglomeriertem Ferrit)\n- Herstellung von keramischen Waren für Laboratorien, zu chemischen und anderen technischen Zwecken"@de .

<http://classif-mcp.local/i14y/noga2025/234400/note/inclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere include:\n- fabbricazione di magneti permanenti e di articoli destinati a diventare magneti permanenti dopo la magnetizzazione, di materiali diversi dal metallo, ad esempio ferrite agglomerata\n- fabbricazione di prodotti ceramici per laboratorio, per usi chimici o per altri usi tecnici"@it .

<http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This type excludes:\n\n- manufacture of refractory ceramic goods, see 232000\n\n- manufacture of ceramic building materials, see 233\n\n- manufacture of artificial stone (e.g. cultured marble), see 236600"@en .

<http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote/fr> a xkos:ExplanatoryNote ;
    xkos:plainText "Ce genre ne comprend pas :\n\n- la fabrication de produits céramiques réfractaires, voir 232000\n\n- la fabrication de matériaux de construction en céramique, voir 233\n\n- la fabrication de pierres artificielles (par ex. le marbre de culture), voir 236600"@fr .

<http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote/de> a xkos:ExplanatoryNote ;
    xkos:plainText "Diese Art umfasst nicht:\n- Herstellung von feuerfesten keramischen Erzeugnissen, siehe 232000\n- Herstellung von keramischen Baustoffen, siehe 233\n- Herstellung von Kunststein (z. B. Kunstmarmor), siehe 236600"@de .

<http://classif-mcp.local/i14y/noga2025/234400/note/exclusionNote/it> a xkos:ExplanatoryNote ;
    xkos:plainText "Questo genere non include:\n- fabbricazione di prodotti ceramici refrattari, cfr. 232000\n- fabbricazione di prodotti ceramici per l'edilizia, cfr. 233\n- fabbricazione di pietra artificiale, ad esempio marmo coltivato, cfr. 236600"@it .

<http://classif-mcp.local/i14y/noga2025/2345> a skos:Concept ;
    skos:inScheme <http://classif-mcp.local/i14y/noga2025/scheme> ;
