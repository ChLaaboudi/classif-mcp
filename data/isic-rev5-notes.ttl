<http://classif-mcp.local/unsd/isic-rev5/476> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/476/note/coreContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/476/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group includes the specialised retail sale of cultural and recreation goods, e.g. books, newspapers, audio and video recordings on physical media, sporting equipment, games and toys."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
