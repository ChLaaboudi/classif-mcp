<http://classif-mcp.local/unsd/isic-rev5/4774> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/4774/note/coreContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/4774/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class includes:\n- retail sale of second-hand books\n- retail sale of antiques\n- retail sale of second-hand clothes\n- retail sale of second-hand furniture\n- retail sale of second-hand household appliances\n- retail sale of other second-hand goods"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4774> xkos:exclusionNote <http://classif-mcp.local/unsd/isic-rev5/4774/note/exclusionNote> .
<http://classif-mcp.local/unsd/isic-rev5/4774/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class excludes: \n- retail sale of second-hand motor vehicles, motorcycles and related parts and accessories, see 478\n- activities of retail auctioneering houses of new and used third party goods, including internet retail auctions, see 479\n- activities of space rental, including staff, for second-hand goods, see 4790\n- activities of pawn shops, see 6495"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/478> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/478/note/coreContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/478/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group includes retail sale of new and second hand motor vehicles, motorcycles and all kinds of parts, components, supplies, tools and accessories for motor vehicles and motorcycles, such as:\n• rubber tyres and inner tubes for tyres\n• spark plugs, batteries, lighting equipment, vehicle charging equipment and electrical parts etc."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/478> xkos:additionalContentNote <http://classif-mcp.local/unsd/isic-rev5/478/note/additionalContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/478/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group includes also: \n- retail trade in used parts and accessories after dismantling of cars or other motor vehicles \n- retail sale of parts and accessories for electric motor vehicles and motorcycles"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/478> xkos:exclusionNote <http://classif-mcp.local/unsd/isic-rev5/478/note/exclusionNote> .
<http://classif-mcp.local/unsd/isic-rev5/478/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group excludes: \n- intermediary services in wholesale, see 4610\n- intermediary services in retail trade of motor vehicles and motorcycles, see 479\n- on-demand passenger transport service activities by vehicle with driver, see 4922\n- rental and leasing of motor vehicles without driver, see 771\n- maintenance and repair of motor vehicles and motorcycles, see group 953"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4781> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/4781/note/coreContentNote> .
