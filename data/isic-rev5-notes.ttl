    xkos:plainText "This class includes:\n- retail sale of new and used motor vehicles including electrical vehicles:\n• passenger motor vehicles\n• camping vehicles such as caravans and motor homes"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4781> xkos:additionalContentNote <http://classif-mcp.local/unsd/isic-rev5/4781/note/additionalContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/4781/note/additionalContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class also includes:\n- retail sale of off-road motor vehicles \n- retail sale of trailers for motor vehicles"@en ;
