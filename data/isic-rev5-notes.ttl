<http://classif-mcp.local/unsd/isic-rev5/477> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/477/note/coreContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/477/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This group includes the retail sale of various goods not elsewhere classified, e.g. clothing, footwear and leather articles, pharmaceutical and medical goods, watches, souvenirs, cleaning products, toiletries, flowers, pets , etc."@en ;
