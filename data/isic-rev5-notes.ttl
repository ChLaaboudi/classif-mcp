<http://classif-mcp.local/unsd/isic-rev5/4761/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class includes:\n- retail sale of books of all kinds\n- retail sale of newspapers and stationery"@en ;
