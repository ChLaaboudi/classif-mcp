<http://classif-mcp.local/unsd/isic-rev5/4761> xkos:exclusionNote <http://classif-mcp.local/unsd/isic-rev5/4761/note/exclusionNote> .
<http://classif-mcp.local/unsd/isic-rev5/4761/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class excludes:\n- retail sale of second-hand or antique books, see 4774\n- distributing e-books and audio books via streaming and downloading by book publishers, see 5811\n- distribution of newspapers via streaming or downloading by their publishers, see 5812\n- distribution of periodicals and journals via streaming or downloading by their publishers, see 5813"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4762> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/4762/note/coreContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/4762/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class includes:\n- retail sale of sports goods, including fishing gear, weapons and ammunitions for hunting, camping goods, etc.\n- retail sale of boats\n- retail sale bicycles, including electric bicycles, monowheels, hoverboards, kick scooters, segways\n- retail sale of special footwear for sports e.g. football shoes, ice skates, ski boots, etc. \n- retail sale of special sports equipment clothes for skiing, martial arts, ballet, etc\n- retail sale of parachutes, tents, sleeping bags, etc."@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4762> xkos:exclusionNote <http://classif-mcp.local/unsd/isic-rev5/4762/note/exclusionNote> .
<http://classif-mcp.local/unsd/isic-rev5/4762/note/exclusionNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class excludes:\n- retail sale of non-specialised sport footwear, e.g. tennis shoes, basketball shoes, gym shoes, training shoes etc, see 4771"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4763> xkos:coreContentNote <http://classif-mcp.local/unsd/isic-rev5/4763/note/coreContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/4763/note/coreContentNote> a xkos:ExplanatoryNote ;
    xkos:plainText "This class includes:\n- retail sale of games and toys, made of all materials\n- retail sale of party supplies, e.g. disguises, masks, party favours (cotillions, jokes, etc.) and magic items"@en ;
    dct:source <https://unstats.un.org/unsd/classifications/Econ/Download/ISIC5_Exp_Notes_19_Aug_2026.xlsx> ;
    skos:editorialNote "Explanatory notes as updated by UNSD on 19 August 2026 (pre-edited version)."@en .

<http://classif-mcp.local/unsd/isic-rev5/4763> xkos:additionalContentNote <http://classif-mcp.local/unsd/isic-rev5/4763/note/additionalContentNote> .
<http://classif-mcp.local/unsd/isic-rev5/4763/note/additionalContentNote> a xkos:ExplanatoryNote ;
